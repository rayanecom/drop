              {% if dentina_black_variant != blank or request.design_mode %}<button class="dt-color-option" type="button" data-dt-color-option data-color="noir" data-slide-index="8" data-variant-id="{{ dentina_black_variant.id }}" data-price="{{ dentina_black_variant.price | money | escape }}" data-available="{{ dentina_black_variant.available }}" aria-pressed="false"><span class="dt-color-option__visual"><img loading="lazy" width="160" height="160" decoding="async" src="{{ 'dentina-black-product-v5-thumb-v9.webp' | asset_url }}" alt=""></span><span>Noir</span></button>{% endif %}
            </div>
