{% assign dentina_product = product %}
{% if dentina_product == blank %}{% assign dentina_product = collections.all.products.first %}{% endif %}
{% if dentina_product != blank %}
  {% assign dentina_variant = dentina_product.selected_or_first_available_variant %}
  {% assign dentina_variant_id = dentina_variant.id %}
  {% assign dentina_display_price = dentina_variant.price | money %}
  {% assign dentina_compare_price = dentina_variant.compare_at_price %}
  {% assign dentina_rating = dentina_product.metafields.reviews.rating.value %}
  {% assign dentina_rating_count = dentina_product.metafields.reviews.rating_count.value %}
  {% assign dentina_white_variant = blank %}
  {% assign dentina_black_variant = blank %}
  {% assign dentina_initial_color = 'blanc' %}
  {% for dentina_option_variant in dentina_product.variants %}
    {% assign dentina_variant_title_lower = dentina_option_variant.title | downcase %}
    {% if dentina_variant_title_lower contains 'noir' or dentina_variant_title_lower contains 'black' %}
      {% if dentina_black_variant == blank %}{% assign dentina_black_variant = dentina_option_variant %}{% endif %}
    {% elsif dentina_variant_title_lower contains 'blanc' or dentina_variant_title_lower contains 'white' %}
      {% if dentina_white_variant == blank %}{% assign dentina_white_variant = dentina_option_variant %}{% endif %}
    {% endif %}
  {% endfor %}
  {% if dentina_white_variant == blank %}{% assign dentina_white_variant = dentina_variant %}{% endif %}
  {% assign dentina_selected_title_lower = dentina_variant.title | downcase %}
  {% if dentina_selected_title_lower contains 'noir' or dentina_selected_title_lower contains 'black' %}{% assign dentina_initial_color = 'noir' %}{% endif %}
{% else %}
  {% assign dentina_variant_id = '' %}
  {% assign dentina_display_price = '69,99 €' %}
  {% assign dentina_initial_color = 'blanc' %}
{% endif %}
{{ 'dentina-site.css' | asset_url | stylesheet_tag }}
{{ 'dentina-polish-v9.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dentina-site.js' | asset_url }}" defer></script>

<div class="dt-site dt-product" data-variant-id="{{ dentina_variant_id }}" data-product-url="{% if dentina_product != blank %}{{ dentina_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-fallback-image="{{ 'dentina-review-approved-6.jpg' | asset_url }}">
