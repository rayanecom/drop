    <section class="dt-pdp-feature-row" aria-label="Les engagements Dentina"><div class="dt-shell dt-four-cards"><article><span aria-hidden="true">≈</span><h3>Technologie ultrasonique</h3></article><article><span aria-hidden="true">✓</span><h3>Garantie produit 2 ans</h3></article><article><span aria-hidden="true">1</span><h3>Utilisation simplifiée</h3></article><article><span aria-hidden="true">FR</span><h3>Support client français</h3></article></div></section>

    <section class="dt-how dt-cycle-showcase" id="fonctionnement" aria-label="Comment utiliser DentinaClean en trois séquences">
      <div class="dt-shell">
        <div class="dt-section-heading">
          <span class="dt-kicker">LE CYCLE EN IMAGES</span>
          <h2>Comment ça marche</h2>
          <p>Une mini-série en trois étapes : regardez le cycle se dérouler automatiquement.</p>
          <button class="dt-cycle-full-link" type="button" data-dt-cycle-open aria-haspopup="dialog">
            <span aria-hidden="true">▶</span>
            <span>Lire la vidéo complète</span>
          </button>
        </div>

        <div class="dt-cycle-story" data-dt-cycle-story>
          <div class="dt-cycle-viewport">
            <article class="dt-cycle-slide is-active" id="dentina-cycle-panel-1-{{ section.id }}" role="tabpanel" aria-labelledby="dentina-cycle-tab-1-{{ section.id }}" data-dt-cycle-slide data-index="0" aria-hidden="false">
              <video muted playsinline preload="none" poster="{{ 'dentina-cycle-step-1-poster-v7.webp' | asset_url }}" data-dt-cycle-video aria-label="Étape 1 : la gouttière est immergée dans l’eau"><source src="{{ 'dentina-cycle-step-1-v7.mp4' | asset_url }}" type="video/mp4"></video>
              <div class="dt-cycle-slide__caption"><span>01</span><div><strong>Immerger</strong><small>L’appareil est placé dans l’eau.</small></div></div>
