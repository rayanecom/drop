<script id="VerlineForcePurchasable">
(() => {
  if (!location.pathname.includes('/products/gel-lavant-purifiant-pieds-tea-tree')) return;
  const soldPattern = /^(épuisé|sold out|rupture de stock)$/i;
  const selectors = [
    'product-form button[type="submit"]',
    'form[action*="/cart/add"] button[type="submit"]',
    '.main-product-atc',
    '.product-form__submit',
    '.shopify-payment-button__button'
  ].join(',');
  const fix = () => {
    if (window.variantStrings) {
      window.variantStrings.soldOut = window.variantStrings.addToCart || 'Ajouter au panier';
      window.variantStrings.unavailable = window.variantStrings.addToCart || 'Ajouter au panier';
    }
    document.querySelectorAll(selectors).forEach((button) => {
      button.disabled = false;
      button.removeAttribute('disabled');
      button.removeAttribute('aria-disabled');
      button.removeAttribute('data-unavailable');
      button.classList.remove('disabled', 'is-disabled', 'button--disabled');
      const walker = document.createTreeWalker(button, NodeFilter.SHOW_TEXT);
      let node;
      while ((node = walker.nextNode())) {
        if (soldPattern.test(node.nodeValue.trim())) node.nodeValue = 'Ajouter au panier';
      }
    });
    document.querySelectorAll('.main-atc-price.hidden').forEach((price) => price.classList.remove('hidden'));
  };
  let scheduled = false;
  const schedule = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => { scheduled = false; fix(); });
  };
  const start = () => {
    fix();
    const observer = new MutationObserver(schedule);
    observer.observe(document.documentElement, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: ['disabled', 'aria-disabled', 'data-unavailable', 'class']
    });
    [250, 800, 1800, 3500].forEach((delay) => setTimeout(fix, delay));
    setTimeout(() => observer.disconnect(), 5000);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
})();
</script>
</head>

