    "custom_liquid_UbLV4a": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% if template.name == 'product' %}\n<template id=\"VerlineInspiTemplate\">\n  <section class=\"aqt-inspir\" aria-labelledby=\"VerlineInspiTitle\">\n    <div class=\"aqt-inspir__head page-width\">\n      <p class=\"aqt-inspir__eyebrow\">ÉDITION PREMIUM</p>\n      <h2 id=\"VerlineInspiTitle\">Ce que nos clients ressentent</h2>\n    </div>\n    <div class=\"aqt-inspir__viewport\" role=\"region\" aria-label=\"Citations clients Verline\" tabindex=\"0\">\n      <div class=\"aqt-inspir__track\">\n        <div class=\"aqt-inspir__group\">\n          <span class=\"aqt-inspir__quote\">« Un rituel qui transforme chaque douche en moment de luxe. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« La formule tea tree qui réconcilie les peaux sensibles avec le soin des pieds. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Verline redéfinit le standard du soin podologique avec une élégance rare. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Enfin un soin pensé pour les pieds, pas un simple savon rebaptisé. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« La fraîcheur du tea tree, la douceur de l'aloe vera — un duo parfait. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Mon rituel quotidien depuis que j'ai découvert Verline. »</span><i></i>\n        </div>\n        <div class=\"aqt-inspir__group\" aria-hidden=\"true\">\n          <span class=\"aqt-inspir__quote\">« Un rituel qui transforme chaque douche en moment de luxe. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« La formule tea tree qui réconcilie les peaux sensibles avec le soin des pieds. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Verline redéfinit le standard du soin podologique avec une élégance rare. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Enfin un soin pensé pour les pieds, pas un simple savon rebaptisé. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« La fraîcheur du tea tree, la douceur de l'aloe vera — un duo parfait. »</span><i></i>\n          <span class=\"aqt-inspir__quote\">« Mon rituel quotidien depuis que j'ai découvert Verline. »</span><i></i>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n<style id=\"VerlineInspiStyles\">.aqt-inspir{--green:#1F3D2B;--ivory:#FBF9F5;position:relative;overflow:hidden;padding:clamp(40px,5.5vw,76px) 0;background:var(--green);border-block:1px solid rgba(31,61,43,.3)}.aqt-inspir__head{position:relative;z-index:1;display:grid;justify-items:center;text-align:center;margin-bottom:clamp(24px,4vw,38px)}.aqt-inspir__eyebrow{margin:0 0 8px;color:rgba(251,249,245,.65);font:700 11px/1.2 \"DM Sans\",sans-serif;letter-spacing:.18em;text-transform:uppercase}.aqt-inspir h2{max-width:780px;margin:0;color:var(--ivory);font:500 clamp(28px,4.5vw,48px)/1.05 \"Playfair Display\",Georgia,serif;letter-spacing:-.03em}.aqt-inspir__viewport{position:relative;z-index:1;overflow:hidden;padding:14px 0;outline:none;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}.aqt-inspir__viewport:focus-visible{box-shadow:inset 0 0 0 2px var(--ivory)}.aqt-inspir__track{display:flex;width:max-content;will-change:transform;animation:aqtInspiScroll 40s linear infinite}.aqt-inspir__group{display:flex;align-items:center;flex-shrink:0;gap:0}.aqt-inspir__quote{display:inline-flex;align-items:center;justify-content:center;padding:0 clamp(24px,4vw,48px);color:rgba(251,249,245,.9);font:italic 500 clamp(16px,2vw,22px)/1.4 \"Playfair Display\",Georgia,serif;letter-spacing:-.01em;white-space:nowrap}.aqt-inspir__group i{width:5px;height:5px;flex:0 0 auto;background:rgba(251,249,245,.4);border-radius:50%}.aqt-inspir__viewport:hover .aqt-inspir__track,.aqt-inspir__viewport:focus-within .aqt-inspir__track{animation-play-state:paused}@keyframes aqtInspiScroll{to{transform:translate3d(-50%,0,0)}}@media(max-width:749px){.aqt-inspir{padding:34px 0 30px}.aqt-inspir__head{padding-inline:20px;margin-bottom:22px}.aqt-inspir h2{font-size:clamp(30px,4.2vw,50px)}.aqt-inspir__quote{font-size:clamp(14px,4vw,18px);padding-inline:20px}.aqt-inspir__viewport{-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}}@media(prefers-reduced-motion:reduce){.aqt-inspir__viewport{overflow-x:auto;-webkit-mask-image:none;mask-image:none;scrollbar-width:thin}.aqt-inspir__track{animation:none}.aqt-inspir__group[aria-hidden=\"true\"]{display:none}}</style>\n<script id=\"VerlineInspiInstaller\">(function(){function installVerlineInspir(){var main=document.getElementById('MainContent');var template=document.getElementById('VerlineInspiTemplate');if(!main||!template)return;var reviewsEnd=main.querySelector('[id$=\"__custom_liquid_UbLV4a\"]')||main.querySelector('[id$=\"__verline_avis\"]');if(reviewsEnd&&!main.querySelector('.aqt-inspir')){reviewsEnd.insertAdjacentElement('afterend',template.content.firstElementChild.cloneNode(true));}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',installVerlineInspir);else installVerlineInspir();setTimeout(installVerlineInspir,450);setTimeout(installVerlineInspir,1400);document.addEventListener('shopify:section:load',installVerlineInspir);})();</script>\n{% endif %}",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 16
      }
    },
    "verline_story": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"vrl-journey\" aria-labelledby=\"vrl-journey-title\">\n  <div class=\"vrl-journey__inner\">\n    <header class=\"vrl-journey__head\">\n      <p class=\"vrl-journey__eyebrow\">LE RITUEL VERLINE</p>\n      <h2 id=\"vrl-journey-title\">Du premier inconfort au retour d’une sensation nette.</h2>\n      <p>Comprenez le problème, découvrez le geste et visualisez chaque étape de votre nouvelle routine.</p>\n    </header>\n\n    <div class=\"vrl-journey__steps\">\n      <article class=\"vrl-journey__step\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-a-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Quand l’inconfort des pieds revient au quotidien\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>01 · LE PROBLÈME</span>\n          <h3>Quand l’inconfort finit par prendre toute la place.</h3>\n          <p>Humidité, peau qui tiraille, démangeaisons et odeurs persistantes : les pieds enfermés toute la journée ont besoin d’un soin pensé pour eux.</p>\n        </div>\n      </article>\n\n      <article class=\"vrl-journey__step vrl-journey__step--reverse\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-f-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Visuel avant et après du rituel Verline pour les pieds\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>02 · L’OBJECTIF</span>\n          <h3>Retrouver des pieds visiblement plus nets et confortables.</h3>\n          <p>Une routine régulière aide à maintenir une peau propre, fraîche et soignée, sans ajouter un protocole compliqué à votre journée.</p>\n        </div>\n      </article>\n\n      <article class=\"vrl-journey__step\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-d-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Tea Tree, menthe poivrée et extraits botaniques du gel Verline\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>03 · LA FORMULE</span>\n          <h3>Des actifs choisis pour une routine ciblée.</h3>\n          <p>Tea Tree, menthe poivrée, aloe vera et extraits botaniques réunis dans un gel lavant frais, simple à doser et agréable à utiliser.</p>\n        </div>\n      </article>\n\n      <article class=\"vrl-journey__step vrl-journey__step--reverse\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-b-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Flacon Verline utilisé sous la douche\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>04 · SOUS LA DOUCHE</span>\n          <h3>Deux minutes pour installer le bon geste.</h3>\n          <p>Appliquez sur peau humide, faites mousser en insistant entre les orteils, puis rincez soigneusement. Le gel s’intègre directement à votre douche.</p>\n        </div>\n      </article>\n\n      <article class=\"vrl-journey__step\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-e-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Les étapes du rituel quotidien Verline\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>05 · LE RITUEL</span>\n          <h3>Masser, rincer, sécher : trois gestes essentiels.</h3>\n          <p>La régularité compte. Après le rinçage, séchez soigneusement vos pieds, en particulier entre les orteils, pour limiter l’humidité résiduelle.</p>\n        </div>\n      </article>\n\n      <article class=\"vrl-journey__step vrl-journey__step--reverse\">\n        <div class=\"vrl-journey__media\">\n          <img src=\"{{ 'verline-c-carre.png' | file_url }}\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\" alt=\"Femme retrouvant une sensation de confort avec son rituel Verline\">\n        </div>\n        <div class=\"vrl-journey__copy\">\n          <span>06 · LE RÉSULTAT</span>\n          <h3>Retrouvez le confort au quotidien.</h3>\n          <p>Une sensation de propreté, de fraîcheur et de confiance après chaque utilisation, dans un rituel aussi simple qu’élégant.</p>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"vrl-journey__cta\">\n      <a href=\"#ProductInfo-template--23505457479900__main\">Choisir mon rituel · 29,90&nbsp;€</a>\n      <p>Une routine ciblée · un geste simple · un format de 100 ml</p>\n    </div>\n  </div>\n</section>\n\n<style>\n  .vrl-journey,\n  .vrl-journey * { box-sizing: border-box; }\n  .vrl-journey {\n    --vrl-green: #1F3D2B;\n    --vrl-amber: #A85C2A;\n    --vrl-amber-dark: #8E4C21;\n    --vrl-ivory: #FBF9F5;\n    --vrl-sand: #EFEAE1;\n    --vrl-black: #1A1A18;\n    --vrl-grey: #3A3A36;\n    background: var(--vrl-ivory);\n    color: var(--vrl-black);\n    padding: clamp(40px,5.5vw,76px) 0;\n    overflow: hidden;\n  }\n  .vrl-journey__inner { width: min(1200px, 100%); margin: 0 auto; }\n  .vrl-journey__head { max-width: 820px; margin: 0 auto clamp(28px, 5vw, 54px); padding: 0 20px; text-align: center; }\n  .vrl-journey__eyebrow,\n  .vrl-journey__copy > span {\n    color: var(--vrl-green);\n    font-family: \"DM Sans\", sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .17em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n  .vrl-journey__head h2,\n  .vrl-journey__copy h3 {\n    color: var(--vrl-black);\n    font-family: \"Playfair Display\", Georgia, serif;\n    font-weight: 600;\n    letter-spacing: -.025em;\n  }\n  .vrl-journey__head h2 { margin: 10px 0 14px; font-size: clamp(30px,4.2vw,50px); line-height: 1.05; }\n  .vrl-journey__head > p:last-child { margin: 0 auto; max-width: 620px; color: var(--vrl-grey); font: 400 16px/1.65 \"DM Sans\", sans-serif; }\n  .vrl-journey__steps { display: grid; gap: 22px; padding: 0 16px; }\n  .vrl-journey__step {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    align-items: stretch;\n    overflow: hidden;\n    min-height: 520px;\n    border: 1px solid rgba(31, 61, 43, .13);\n    border-radius: 24px;\n    background: var(--vrl-sand);\n    box-shadow: 0 16px 44px rgba(31, 61, 43, .07);\n  }\n  .vrl-journey__media { min-width: 0; background: var(--vrl-sand); }\n  .vrl-journey__media img {\n    display: block !important;\n    width: 100% !important;\n    height: 100% !important;\n    min-height: 0 !important;\n    aspect-ratio: 1 / 1;\n    object-fit: contain !important;\n    object-position: center !important;\n    background: var(--vrl-sand);\n  }\n  .vrl-journey__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 5vw, 70px); }\n  .vrl-journey__copy h3 { margin: 13px 0 16px; font-size: clamp(19px,2.1vw,27px); line-height: 1.08; }\n  .vrl-journey__copy p { margin: 0; color: var(--vrl-grey); font: 400 clamp(15px, 1.5vw, 17px)/1.7 \"DM Sans\", sans-serif; }\n  .vrl-journey__step--reverse .vrl-journey__media { order: 2; }\n  .vrl-journey__step--reverse .vrl-journey__copy { order: 1; }\n  .vrl-journey__cta { padding: clamp(32px, 5vw, 54px) 20px 0; text-align: center; }\n  .vrl-journey__cta a {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 56px;\n    padding: 15px 30px;\n    border-radius: 999px;\n    background: var(--vrl-amber);\n    color: #fff;\n    font: 700 16px/1.2 \"DM Sans\", sans-serif;\n    text-decoration: none;\n    box-shadow: 0 12px 28px rgba(168, 92, 42, .22);\n    transition: background .2s ease, transform .2s ease;\n  }\n  .vrl-journey__cta a:hover { background: var(--vrl-amber-dark); transform: translateY(-1px); }\n  .vrl-journey__cta p { margin: 12px 0 0; color: #5C5C55; font: 500 12px/1.5 \"DM Sans\", sans-serif; letter-spacing: .04em; }\n\n  @media (max-width: 749px) {\n    .vrl-journey { padding: 40px 0 46px; }\n    .vrl-journey__head { margin-bottom: 26px; padding: 0 18px; text-align: left; }\n    .vrl-journey__head h2 { font-size: clamp(30px,4.2vw,50px); }\n    .vrl-journey__steps { gap: 16px; padding: 0; }\n    .vrl-journey__step {\n      display: flex;\n      flex-direction: column;\n      min-height: 0;\n      border-left: 0;\n      border-right: 0;\n      border-radius: 0;\n      box-shadow: none;\n    }\n    .vrl-journey__step--reverse .vrl-journey__media,\n    .vrl-journey__step--reverse .vrl-journey__copy { order: initial; }\n    .vrl-journey__media { width: 100%; }\n    .vrl-journey__media img {\n      width: 100% !important;\n      height: auto !important;\n      min-height: auto !important;\n      aspect-ratio: 1 / 1;\n      object-fit: contain !important;\n    }\n    .vrl-journey__copy { padding: 25px 22px 30px; }\n    .vrl-journey__copy h3 { margin-top: 10px; font-size:clamp(19px,2.1vw,27px); }\n    .vrl-journey__cta { padding-top: 30px; }\n    .vrl-journey__cta a { width: 100%; max-width: 350px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .vrl-journey__cta a { transition: none; }\n  }\n</style>",
