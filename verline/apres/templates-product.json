        "visibility": "always-display",
        "custom_liquid": "<style>\n.vrl-compare-v5{background:#EFEAE1;padding:clamp(34px,6vw,72px) 18px;font-family:\"DM Sans\",system-ui,sans-serif;color:#1A1A18}\n.vrl-compare-v5__inner{max-width:960px;margin:0 auto}\n.vrl-compare-v5__eyebrow{margin:0 0 9px;text-align:center;color:#1F3D2B;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}\n.vrl-compare-v5 h2{max-width:800px;margin:0 auto 12px;text-align:center;color:#1F3D2B;font-family:\"Playfair Display\",Georgia,serif;font-size:clamp(30px,4.2vw,50px);line-height:1.08}\n.vrl-compare-v5__intro{max-width:650px;margin:0 auto 28px;text-align:center;color:#3A3A36;font-size:15px;line-height:1.55}\n.vrl-compare-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.vrl-compare-card{overflow:hidden;border:1px solid rgba(31,61,43,.14);border-radius:18px;background:#fff;box-shadow:0 12px 34px rgba(31,61,43,.07)}\n.vrl-compare-card h3{margin:0;padding:17px 18px;background:#1F3D2B;color:#FBF9F5;font-family:\"Playfair Display\",Georgia,serif;font-size:clamp(19px,2.1vw,27px);text-align:center}\n.vrl-compare-card table{width:100%;border-collapse:collapse;font-size:13px}\n.vrl-compare-card th,.vrl-compare-card td{padding:12px 13px;border-bottom:1px solid rgba(31,61,43,.10);text-align:left;vertical-align:middle}\n.vrl-compare-card thead th{color:#1F3D2B;background:#EFEAE1;font-size:11px;letter-spacing:.06em;text-transform:uppercase}\n.vrl-compare-card tbody th{width:30%;color:#1A1A18;font-weight:750}\n.vrl-compare-card tbody td:nth-child(2){color:#1F3D2B;background:rgba(31,61,43,.045);font-weight:750}\n.vrl-compare-card tbody tr:last-child>*{border-bottom:0}\n@media(max-width:760px){\n .vrl-compare-v5{padding:30px 12px}\n .vrl-compare-grid{grid-template-columns:1fr}\n .vrl-compare-card{border-radius:15px}\n .vrl-compare-card table,.vrl-compare-card tbody,.vrl-compare-card tr,.vrl-compare-card th,.vrl-compare-card td{display:block}\n .vrl-compare-card thead{display:none}\n .vrl-compare-card tbody tr{display:grid;grid-template-columns:1fr 1fr;margin:10px;border:1px solid rgba(31,61,43,.11);border-radius:11px;overflow:hidden}\n .vrl-compare-card tbody th{grid-column:1/-1;width:auto;padding:8px 10px;background:#EFEAE1;font-size:11px;text-transform:uppercase;letter-spacing:.05em}\n .vrl-compare-card tbody td{padding:10px;border:0;font-size:12px}\n .vrl-compare-card tbody td:nth-child(2)::before{content:\"Verline\";display:block;margin-bottom:3px;font-size:9px;letter-spacing:.08em;text-transform:uppercase}\n .vrl-compare-card tbody td:nth-child(3)::before{content:\"Alternative\";display:block;margin-bottom:3px;color:#5C5C55;font-size:9px;letter-spacing:.08em;text-transform:uppercase}\n}\n</style>\n<section class=\"vrl-compare-v5\" aria-labelledby=\"vrl-compare-title\">\n <div class=\"vrl-compare-v5__inner\">\n  <p class=\"vrl-compare-v5__eyebrow\">Comparer avant de choisir</p>\n  <h2 id=\"vrl-compare-title\">Une action ciblée là où un gel ordinaire s'arrête.</h2>\n  <p class=\"vrl-compare-v5__intro\">Ce que vous obtenez avec Verline, et ce qu'un savon du commerce ne fera jamais.</p>\n  <div class=\"vrl-compare-grid\">\n   <article class=\"vrl-compare-card\"><h3>Verline vs Savon ordinaire</h3><table><thead><tr><th></th><th>VERLINE</th><th>Savon</th></tr></thead><tbody>\n    <tr><th>Texture</th><td>✅ Gel dosé</td><td>Variable</td></tr><tr><th>Actifs</th><td>✅ Tea Tree, menthe, aloe</td><td>Génériques</td></tr><tr><th>Usage</th><td>✅ Pieds + corps</td><td>Corps seul</td></tr><tr><th>Mycoses</th><td>✅ Action ciblée</td><td>❌ Aucune</td></tr><tr><th>Odeurs</th><td>✅ En profondeur</td><td>⚠️ Masquées</td></tr><tr><th>Routine</th><td>✅ Remplace le gel</td><td>✅ Oui</td></tr><tr><th>Prix</th><td>✅ Accessible</td><td>✅ Faible</td></tr>\n   </tbody></table></article>\n   <article class=\"vrl-compare-card\"><h3>Verline vs Traitement médical</h3><table><thead><tr><th></th><th>VERLINE</th><th>Médical</th></tr></thead><tbody>\n    <tr><th>Texture</th><td>✅ Gel dosé</td><td>Crème</td></tr><tr><th>Actifs</th><td>✅ Naturels ciblés</td><td>Chimique</td></tr><tr><th>Usage</th><td>✅ Quotidien</td><td>Ponctuel</td></tr><tr><th>Mycoses</th><td>✅ Action ciblée</td><td>⚠️ Contraignant</td></tr><tr><th>Odeurs</th><td>✅ En profondeur</td><td>❌ Non traité</td></tr><tr><th>Routine</th><td>✅ Simple</td><td>❌ Étape en plus</td></tr><tr><th>Prix</th><td>✅ Accessible</td><td>❌ Élevé</td></tr>\n   </tbody></table></article>\n  </div>\n </div>\n</section>",
