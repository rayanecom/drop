%) rotate(3deg); }\n  .vrl-offer__visual--3 img:nth-child(1) { transform: translate(-82%,-50%) rotate(-5deg); }\n  .vrl-offer__visual--3 img:nth-child(2) { z-index: 2; transform: translate(-50%,-53%); }\n  .vrl-offer__visual--3 img:nth-child(3) { transform: translate(-18%,-50%) rotate(5deg); }\n  .vrl-offer__copy b, .vrl-offer__copy span, .vrl-offer__price strong, .vrl-offer__price small { display: block; }\n  .vrl-offer__copy b { color: #1F3D2B; font-size: 15px; line-height: 1.25; }\n  .vrl-offer__copy span { margin-top: 5px; color: #5C5C55; font-size: 12px; line-height: 1.35; }\n  .vrl-offer__price { min-width: 82px; text-align: right; }\n  .vrl-offer__price strong { color: #1A1A18; font-family: \"Playfair Display\", Georgia, serif; font-size: 19px; font-weight: 650; white-space: nowrap; }\n  .vrl-offer__price small { margin-top: 4px; color: #5C5C55; font-size: 10px; white-space: nowrap; }\n  .vrl-offer__price s { display: block; margin-bottom: 2px; color: #5C5C55; font-size: 11px; text-decoration-thickness: 1px; }\n  .vrl-offer__saving { display: block; margin-top: 4px; color: #1F3D2B; font-size: 10px; font-weight: 800; white-space: nowrap; }\n  .vrl-offer__badge { position: absolute; z-index: 3; top: -9px; left: 104px; padding: 4px 9px; border-radius: 999px; color: #FBF9F5; background: #1F3D2B; font-size: 9px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }\n  .vrl-bundles__note { margin: 9px 2px 0; color: #5C5C55; font-size: 11px; line-height: 1.45; }\n  @media (max-width: 480px) {\n    .vrl-offer__card { grid-template-columns: 68px minmax(0,1fr) auto; gap: 10px; padding-inline: 10px; }\n    .vrl-offer > input:checked + .vrl-offer__card { padding-inline: 9px; }\n    .vrl-offer__visual { width: 64px; }\n    .vrl-offer__visual img { width: 43px; height: 53px; }\n    .vrl-offer__copy b { font-size: 14px; }\n    .vrl-offer__copy span { font-size: 10px; }\n    .vrl-offer__price { min-width: 70px; }\n    .vrl-offer__price strong { font-size: 17px; }\n    .vrl-offer__badge { left: 78px; }\n  }\n  @media (prefers-reduced-motion: reduce) { .vrl-offer__card { transition: none; } }\n</style>\n\n<div class=\"vrl-bundles\" id=\"vrlBundles-{{ section.id }}\" data-vrl-bundles>\n  <fieldset>\n    <legend>Prolongez le rituel, réduisez le prix par flacon</legend>\n    <div class=\"vrl-bundles__list\">\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"1\" data-total=\"{{ product.price | money | escape }}\">\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__visual\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"eager\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>1 flacon</b><span>Pour découvrir le rituel Verline</span></span>\n          <span class=\"vrl-offer__price\"><strong>{{ product.price | money }}</strong><small>{{ product.price | money }} / flacon</small></span>\n        </span>\n      </label>\n\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"2\" data-total=\"{{ 5290 | money | escape }}\" checked>\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__badge\">Le plus choisi</span>\n          <span class=\"vrl-offer__visual vrl-offer__visual--2\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>2 flacons</b><span>Économisez 6,90 € · 2 routines en une commande</span></span>\n          <span class=\"vrl-offer__price\"><s>{{ product.price | times: 2 | money }}</s><strong>{{ 5290 | money }}</strong><small>{{ 2645 | money }} / flacon</small><span class=\"vrl-offer__saving\">Économisez {{ 690 | money }}</span></span>\n        </span>\n      </label>\n\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"3\" data-total=\"{{ 6990 | money | escape }}\">\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__badge\">Meilleure valeur</span>\n          <span class=\"vrl-offer__visual vrl-offer__visual--3\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>3 flacons</b><span>Meilleur prix par flacon · votre routine en réserve</span></span>\n          <span class=\"vrl-offer__price\"><s>{{ product.price | times: 3 | money }}</s><strong>{{ 6990 | money }}</strong><small>{{ 2330 | money }} / flacon</small><span class=\"vrl-offer__saving\">Économisez {{ 1980 | money }}</span></span>\n        </span>\n      </label>\n    </div>\n    <p class=\"vrl-bundles__note\">Remise appliquée automatiquement au panier pour le Duo et le Trio · aucun code nécessaire.</p>\n  </fieldset>\n</div>\n\n<script>\n(() => {\n  const root = document.getElementById('vrlBundles-{{ section.id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const boot = () => {\n    const quantity = document.querySelector('#Quantity-Form-{{ section.id }} input[name=\"quantity\"]') || document.querySelector('input[name=\"quantity\"][form^=\"product-form-\"]');\n    const radios = Array.from(root.querySelectorAll('input[type=\"radio\"]'));\n    if (!quantity || !radios.length) return;\n\n    const nativeQuantity = quantity.closest('.product-form__quantity, [id^=\"Quantity-Form-\"]');\n    if (nativeQuantity && !root.contains(nativeQuantity)) {\n      nativeQuantity.classList.add('vrl-native-quantity--managed');\n      nativeQuantity.setAttribute('aria-hidden', 'true');\n      quantity.tabIndex = -1;\n    }\n\n    const render = (radio, dispatch) => {\n      const qty = Math.max(1, parseInt(radio.value, 10) || 1);\n      const total = radio.dataset.total || '';\n      quantity.value = String(qty);\n      if (dispatch) {\n        quantity.dispatchEvent(new Event('input', { bubbles: true }));\n        quantity.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n      const updatePurchaseLabels = () => {\n        const atcPrice = document.getElementById('main-atc-price-{{ section.id }}');\n        if (atcPrice) atcPrice.textContent = total + ' •';\n        const stickyMeta = document.querySelector('[data-vrl-sticky] .vrl-sticky__meta span');\n        if (stickyMeta) stickyMeta.textContent = qty + (qty > 1 ? ' flacons · ' : ' flacon · ') + total;\n      };\n      updatePurchaseLabels();\n      window.setTimeout(updatePurchaseLabels, 80);\n    };\n\n    root.addEventListener('change', (event) => {\n      if (event.target.matches('input[type=\"radio\"]')) render(event.target, true);\n    });\n    quantity.addEventListener('change', () => {\n      const match = radios.find((radio) => radio.value === String(quantity.value));\n      if (match) {\n        match.checked = true;\n        render(match, false);\n      }\n    });\n    render(radios.find((radio) => radio.checked) || radios[0], false);\n  };\n\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });\n  else boot();\n})();\n</script>"
