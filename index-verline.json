3.5rem;\n    margin-top: 2rem;\n    padding: .95rem 1.6rem;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--vl-amber);\n    border-radius: 2px;\n    background: var(--vl-amber);\n    color: var(--vl-ivory);\n    font-weight: 700;\n    line-height: 1.2;\n    text-decoration: none;\n    transition: background-color .18s ease, border-color .18s ease, transform .18s ease;\n  }\n  .vl-premium__buy:hover { border-color: var(--vl-amber-hover); background: var(--vl-amber-hover); color: var(--vl-ivory); transform: translateY(-1px); }\n  .vl-premium__buy:focus-visible, .vl-premium__text-link:focus-visible { outline: 3px solid var(--vl-green); outline-offset: 4px; }\n  .vl-premium__microcopy { margin: .85rem 0 0; color: var(--vl-muted); font-size: .82rem; }\n\n  @media (max-width: 900px) {\n    .vl-premium__grid--3, .vl-premium__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .vl-premium__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .vl-premium__fact:nth-child(2) { border-right: 0; }\n    .vl-premium__fact:nth-child(-n+2) { border-bottom: 1px solid rgba(251, 249, 245, .23); }\n    .vl-premium__reviews { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 620px) {\n    .vl-premium__section { padding-inline: 1rem; }\n    .vl-premium__grid--3, .vl-premium__grid--4, .vl-premium__principles { grid-template-columns: 1fr; }\n    .vl-premium__index { margin-bottom: 1.8rem; }\n    .vl-premium__facts { grid-template-columns: 1fr; }\n    .vl-premium__fact { border-right: 0; border-bottom: 1px solid rgba(251, 249, 245, .23); }\n    .vl-premium__fact:last-child { border-bottom: 0; }\n    .vl-premium__buy { width: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .vl-premium__buy { transition: none; }\n  }\n.vl-premium__contact{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(2rem,7vw,5.5rem);align-items:start}.vl-premium__form{display:grid;gap:1rem}.vl-premium__form label{display:block;margin-bottom:.4rem;color:var(--vl-ink);font-size:.84rem;font-weight:700}.vl-premium__form input,.vl-premium__form textarea{width:100%;padding:.9rem;border:1px solid rgba(31,61,43,.27);border-radius:0;background:var(--vl-ivory);color:var(--vl-ink);font:inherit}.vl-premium__form textarea{min-height:9rem;resize:vertical}.vl-premium__form input:focus,.vl-premium__form textarea:focus{outline:2px solid var(--vl-green);outline-offset:2px}.vl-premium__send{min-height:3.25rem;padding:.85rem 1.4rem;border:1px solid var(--vl-green);background:var(--vl-green);color:var(--vl-ivory);font:inherit;font-weight:700;cursor:pointer}.vl-premium__send:hover{background:#162e20}.vl-premium__status{padding:1rem;border:1px solid rgba(31,61,43,.2);background:var(--vl-ivory);color:var(--vl-copy)}@media(max-width:900px){.vl-premium__contact{grid-template-columns:1fr}}.vl-premium__formula-split{display:grid;grid-template-columns:minmax(260px,.78fr) minmax(0,1.22fr);gap:clamp(1.2rem,3vw,2.4rem);align-items:stretch;margin-top:2rem}.vl-premium__formula-visual{overflow:hidden;margin:0;border:1px solid rgba(31,61,43,.14);border-radius:18px;background:var(--vl-sand)}.vl-premium__formula-visual img{width:100%;height:100%;max-height:640px;display:block;object-fit:contain}.vl-premium__formula-split>.vl-premium__grid{grid-template-columns:1fr;margin-top:0}.vl-premium__formula-split .vl-premium__card{padding:1.25rem}.vl-premium__formula-split .vl-premium__index{margin-bottom:1rem}@media(max-width:760px){.vl-premium__formula-split{grid-template-columns:1fr}.vl-premium__formula-visual img{max-height:none}.vl-premium__section{padding-block:2.5rem}}\n</style>\n<div class=\"vl-premium\">\n<section class=\"vl-premium__section\" id=\"formule\" aria-labelledby=\"vl-ingredients-title\">\n    <div class=\"vl-premium__inner\">\n      <p class=\"vl-premium__eyebrow\">Pourquoi ça agit</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-ingredients-title\">Trois actifs. Une action ciblée.</h2>\n      <p class=\"vl-premium__intro\">Rien d’ésotérique : trois actifs botaniques, chacun avec un rôle précis, dans un gel qui se dose et se rince comme n’importe quel savon.</p>\n\n      <div class=\"vl-premium__formula-split\"><figure class=\"vl-premium__formula-visual\"><img src=\"https://cdn.shopify.com/s/files/1/0843/2372/9628/files/hf_20260829_112044_745596dd-1655-4173-9714-39056f9e4fa6.png\" alt=\"Le flacon Verline et ses ingrédients signatures\" loading=\"lazy\" width=\"1080\" height=\"1920\"></figure><div class=\"vl-premium__grid vl-premium__grid--3\">\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">01</span>\n          <h3>Tea Tree</h3>\n          <p>Le cœur de la formule : purifiant naturel, il s’attaque à l’origine de l’odeur pendant le lavage.</p>\n        </article>\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">02</span>\n          <h3>Menthe poivrée</h3>\n          <p>L’effet immédiat que vous sentez au rinçage : une fraîcheur nette, qui tient la journée.</p>\n        </article>\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">03</span>\n          <h3>Aloe vera</h3>\n          <p>Il adoucit les peaux sèches et rugueuses, pour que l’usage quotidien reste confortable.</p>\n        </article>\n      </div></div>\n\n      <p class=\"vl-premium__note\">La liste INCI complète et les précautions d’emploi figurant sur l’emballage font foi. <a class=\"vl-premium__text-link\" href=\"{{ verline_product_url }}#composition\">Voir les informations produit</a>.</p>\n    </div>\n  </section>\n</div>",
