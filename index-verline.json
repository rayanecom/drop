  .vl-premium__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .vl-premium__card {\n    min-height: 100%;\n    padding: clamp(1.4rem, 2.5vw, 2rem);\n    border: 1px solid rgba(31, 61, 43, .16);\n    border-radius: 18px;\n    background: var(--vl-ivory);\n  }\n  .vl-premium__index {\n    display: inline-grid;\n    width: 2.5rem;\n    height: 2.5rem;\n    margin-bottom: 2.5rem;\n    place-items: center;\n    border: 1px solid rgba(31, 61, 43, .25);\n    border-radius: 50%;\n    color: var(--vl-green);\n    font-size: .76rem;\n    font-weight: 700;\n    letter-spacing: .08em;\n  }\n  .vl-premium__card h3 {\n    margin: 0 0 .7rem;\n    color: var(--vl-ink);\n    font-family: \"Playfair Display\", serif;\n    font-size: clamp(1.35rem, 2vw, 1.72rem);\n    font-weight: 500;\n    line-height: 1.15;\n  }\n  .vl-premium__card p { margin: 0; color: var(--vl-copy); line-height: 1.65; }\n  .vl-premium__note { margin: 1.5rem 0 0; color: var(--vl-muted); font-size: .86rem; line-height: 1.6; }\n  .vl-premium__text-link {\n    color: var(--vl-green);\n    font-weight: 700;\n    text-decoration-color: rgba(31, 61, 43, .38);\n    text-underline-offset: .25em;\n  }\n  .vl-premium__text-link:hover { text-decoration-color: currentColor; }\n\n  .vl-premium__steps { counter-reset: vl-step; list-style: none; padding: 0; }\n  .vl-premium__steps .vl-premium__card { counter-increment: vl-step; }\n  .vl-premium__steps .vl-premium__index::before { content: \"0\" counter(vl-step); }\n\n  .vl-premium__facts {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    margin-top: 2.75rem;\n    border-top: 1px solid rgba(251, 249, 245, .23);\n    border-bottom: 1px solid rgba(251, 249, 245, .23);\n  }\n  .vl-premium__fact { padding: 1.5rem; border-right: 1px solid rgba(251, 249, 245, .23); }\n  .vl-premium__fact:last-child { border-right: 0; }\n  .vl-premium__fact dt { margin-bottom: .45rem; font-size: .72rem; font-weight: 700; letter-spacing: .12em; opacity: .7