emplate-columns:1fr 1fr;overflow:hidden;border:1px solid rgba(31,61,43,.13);border-radius:12px;background:#fff}\n .vl-cp tbody td{border:0;padding:10px 12px;font-size:12px}.vl-cp tbody td:first-child{grid-column:1/-1;background:#EFEAE1;font-size:10px;letter-spacing:.07em;text-transform:uppercase}\n .vl-cp tbody td:nth-child(2)::before{content:\"Verline\";display:block;margin-bottom:3px;font-size:9px;letter-spacing:.08em;text-transform:uppercase}\n .vl-cp tbody td:nth-child(3)::before{content:\"Nettoyant\";display:block;margin-bottom:3px;color:#5C5C55;font-size:9px;letter-spacing:.08em;text-transform:uppercase}\n .vl-cp__cta a{width:100%}\n}\n</style>\n<section class=\"vl-cp\"><div class=\"vl-cp__in\"><h2>Une action ciblée là où un gel ordinaire s’arrête.</h2><p class=\"vl-cp__sub\">Ce que vous obtenez avec Verline, et ce qu’un savon du commerce ne fera jamais.</p><div class=\"vl-cp__scroll\"><table><thead><tr><th></th><th class=\"vl-us\">Verline</th><th>Nettoyant généraliste</th></tr></thead><tbody>\n<tr><td>Texture</td><td class=\"vl-us vl-y\">Gel facile à doser</td><td class=\"vl-n\">Variable</td></tr><tr><td>Actifs mis en avant</td><td class=\"vl-us vl-y\">Tea Tree, menthe, aloe vera</td><td class=\"vl-n\">Dépend de la formule</td></tr><tr><td>Usage</td><td class=\"vl-us vl-y\">Pieds et corps</td><td class=\"vl-n\">Usage général</td></tr><tr><td>Odeurs tenaces</td><td class=\"vl-us vl-y\">Action ciblée pour les éliminer</td><td class=\"vl-n\">Aucune action ciblée</td></tr><tr><td>Odeurs</td><td class=\"vl-us vl-y\">Aide à les neutraliser</td><td class=\"vl-n\">Dépend de la formule</td></tr><tr><td>Format</td><td class=\"vl-us vl-y\">100 ml</td><td class=\"vl-n\">Variable</td></tr>\n</tbody></table></div>{%- if p != blank -%}<div class=\"vl-cp__cta\"><a href=\"{{ p.url }}\">Voir le produit — {{ p.price | money }}</a></div>{%- endif -%}</div></section>",
