        "visibility": "always-display",
        "custom_liquid": "<div class=\"vl-premium\">\n<section class=\"vl-premium__section\" id=\"contact\" aria-labelledby=\"vl-contact-title\">\n  <div class=\"vl-premium__inner vl-premium__contact\">\n    <div><p class=\"vl-premium__eyebrow\">Besoin d’aide ?</p><h2 class=\"vl-premium__title\" id=\"vl-contact-title\">Une question avant de choisir Verline ?</h2><p class=\"vl-premium__intro\">Écrivez-nous directement. Votre message sera transmis au service client de la boutique.</p><p class=\"vl-premium__note\">Une question sur le produit, votre commande ou un retour ? Écrivez-nous.</p></div>\n    <div>\n      {%- form 'contact', class: 'vl-premium__form' -%}\n        {%- if form.posted_successfully? -%}<p class=\"vl-premium__status\" role=\"status\">Merci. Votre message a bien été envoyé.</p>{%- endif -%}\n        {{ form.errors | default_errors }}\n        <div><label for=\"VlContactName\">Nom</label><input id=\"VlContactName\" name=\"contact[name]\" type=\"text\" autocomplete=\"name\"></div>\n        <div><label for=\"VlContactEmail\">E-mail</label><input id=\"VlContactEmail\" name=\"contact[email]\" type=\"email\" autocomplete=\"email\" required></div>\n        <div><label for=\"VlContactMessage\">Votre message</label><textarea id=\"VlContactMessage\" name=\"contact[body]\" required></textarea></div>\n        <button class=\"vl-premium__send\" type=\"submit\">Envoyer ma question</button>\n      {%- endform -%}\n    </div>\n  </div>\n</section>\n</div>",
