    "verline_story": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .vrl-story {\n    --vrl-green: #1F3D2B;\n    --vrl-ink: #1A1A18;\n    --vrl-text: #3A3A36;\n    --vrl-muted: #5C5C55;\n    --vrl-ivory: #FBF9F5;\n    --vrl-sand: #EFEAE1;\n    color: var(--vrl-ink);\n    background: var(--vrl-ivory);\n    font-family: \"DM Sans\", system-ui, sans-serif;\n  }\n  .vrl-story *, .vrl-story *::before, .vrl-story *::after { box-sizing: border-box; }\n  .vrl-story h2, .vrl-story h3 {\n    margin: 0;\n    color: var(--vrl-ink);\n    font-family: \"Playfair Display\", Georgia, serif;\n    font-weight: 600;\n    letter-spacing: -0.025em;\n  }\n  .vrl-story p { margin: 0; }\n  .vrl-shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }\n  .vrl-eyebrow {\n    margin-bottom: 14px !important;\n    color: var(--vrl-green);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n  .vrl-lead { color: var(--vrl-text); font-size: clamp(16px, 1.5vw, 19px); line-height: 1.72; }\n  .vrl-trust { border-top: 1px solid rgba(31,61,43,.14); border-bottom: 1px solid rgba(31,61,43,.14); background: var(--vrl-ivory); }\n  .vrl-trust__grid { display: grid; grid-template-columns: repeat(3, 1fr); }\n  .vrl-trust__item { padding: 22px 18px; text-align: center; color: var(--vrl-green); font-size: 13px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }\n  .vrl-trust__item + .vrl-trust__item { border-left: 1px solid rgba(31,61,43,.14); }\n  .vrl-editorial { padding: clamp(68px, 9vw, 124px) 0; }\n  .vrl-editorial__grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(44px, 7vw, 92px); align-items: center; }\n  .vrl-editorial__media { position: relative; min-height: 580px; overflow: hidden; background: var(--vrl-sand); }\n  .vrl-editorial__media::after { content: \"\"; position: absolute; inset: 18px; border: 1px solid rgba(251,249,245,.7); pointer-events: none; }\n  .vrl-editorial__media img { width: 100%; height: 100%; min-height: 580px; display: block; object-fit: cover; }\n  .vrl-editorial__copy h2 { max-width: 680px; margin-bottom: 24px; font-size: clamp(38px, 5.1vw, 68px); line-height: 1.02; }\n  .vrl-editorial__copy .vrl-lead { max-width: 610px; }\n  .vrl-signature { display: inline-flex; align-items: center; gap: 13px; margin-top: 30px; color: var(--vrl-green); font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n  .vrl-signature::before { content: \"\"; width: 42px; height: 1px; background: var(--vrl-green); }\n  .vrl-benefits { padding: clamp(66px, 8vw, 106px) 0; background: var(--vrl-sand); }\n  .vrl-section-head { max-width: 780px; margin: 0 auto 46px; text-align: center; }\n  .vrl-section-head h2 { margin-bottom: 18px; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.08; }\n  .vrl-section-head p:last-child { color: var(--vrl-text); font-size: 17px; line-height: 1.65; }\n  .vrl-benefits__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }\n  .vrl-benefit { min-height: 238px; padding: 32px 27px; border: 1px solid rgba(31,61,43,.14); background: rgba(251,249,245,.8); }\n  .vrl-benefit__num { display: block; margin-bottom: 35px; color: var(--vrl-green); font-family: \"Playfair Display\", Georgia, serif; font-size: 30px; font-style: italic; }\n  .vrl-benefit h3 { margin-bottom: 12px; font-size: 23px; }\n  .vrl-benefit p { color: var(--vrl-text); font-size: 15px; line-height: 1.65; }\n  .vrl-ritual { padding: clamp(72px, 9vw, 116px) 0; color: var(--vrl-ivory); background: var(--vrl-green); }\n  .vrl-ritual h2 { max-width: 760px; margin: 0 auto 52px; color: var(--vrl-ivory); text-align: center; font-size: clamp(36px, 4.8vw, 60px); line-height: 1.08; }\n  .vrl-ritual__grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(251,249,245,.22); }\n  .vrl-step { padding: 34px 34px 0; }\n  .vrl-step + .vrl-step { border-left: 1px solid rgba(251,249,245,.22); }\n  .vrl-step__num { display: block; margin-bottom: 28px; color: rgba(251,249,245,.64); font-family: \"Playfair Display\", Georgia, serif; font-size: 36px; font-style: italic; }\n  .vrl-step h3 { margin-bottom: 12px; color: var(--vrl-ivory); font-size: 25px; }\n  .vrl-step p { color: rgba(251,249,245,.78); font-size: 15px; line-height: 1.7; }\n  .vrl-formula { padding: clamp(70px, 9vw, 120px) 0; }\n  .vrl-formula__grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(42px, 7vw, 90px); align-items: center; }\n  .vrl-formula__copy h2 { margin-bottom: 22px; font-size: clamp(36px, 4.8vw, 62px); line-height: 1.05; }\n  .vrl-formula__copy .vrl-lead + .vrl-lead { margin-top: 16px; }\n  .vrl-formula__note { margin-top: 24px !important; padding-top: 18px; border-top: 1px solid rgba(31,61,43,.18); color: var(--vrl-muted); font-size: 13px; line-height: 1.6; }\n  .vrl-formula__media { min-height: 520px; overflow: hidden; background: var(--vrl-sand); }\n  .vrl-formula__media img { width: 100%; height: 100%; min-height: 520px; display: block; object-fit: cover; }\n  .vrl-faq { padding: clamp(68px, 8vw, 108px) 0; background: var(--vrl-sand); }\n  .vrl-faq__grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(42px, 7vw, 86px); }\n  .vrl-faq__intro h2 { margin-bottom: 16px; font-size: clamp(38px, 4.7vw, 58px); line-height: 1.05; }\n  .vrl-faq__intro p:last-child { color: var(--vrl-text); line-height: 1.7; }\n  .vrl-faq details { border-top: 1px solid rgba(31,61,43,.2); }\n  .vrl-faq details:last-child { border-bottom: 1px solid rgba(31,61,43,.2); }\n  .vrl-faq summary { position: relative; padding: 23px 42px 23px 0; color: var(--vrl-ink); font-size: 16px; font-weight: 700; cursor: pointer; list-style: none; }\n  .vrl-faq summary::-webkit-details-marker { display: none; }\n  .vrl-faq summary::after { content: \"+\"; position: absolute; right: 4px; top: 19px; color: var(--vrl-green); font-family: \"Playfair Display\", Georgia, serif; font-size: 28px; font-weight: 400; }\n  .vrl-faq details[open] summary::after { content: \"−\"; }\n  .vrl-faq details p { max-width: 720px; padding: 0 42px 23px 0; color: var(--vrl-text); font-size: 15px; line-height: 1.7; }\n  .vrl-final { padding: clamp(70px, 9vw, 112px) 0; text-align: center; background: var(--vrl-ivory); }\n  .vrl-final__inner { max-width: 820px; margin: 0 auto; }\n  .vrl-final h2 { margin-bottom: 18px; font-size: clamp(38px, 5vw, 64px); line-height: 1.04; }\n  .vrl-final__text { margin: 0 auto 30px !important; max-width: 650px; color: var(--vrl-text); font-size: 17px; line-height: 1.7; }\n  .vrl-buy { display: inline-flex; min-height: 56px; align-items: center; justify-content: center; padding: 16px 30px; border-radius: 2px; color: #FBF9F5 !important; background: #A85C2A; font-size: 15px; font-weight: 700; letter-spacing: .035em; text-decoration: none !important; transition: background .2s ease, transform .2s ease; }\n  .vrl-buy:hover { color: #FBF9F5 !important; background: #8E4C21; transform: translateY(-1px); }\n  .vrl-final__meta { margin-top: 15px !important; color: var(--vrl-muted); font-size: 12px; letter-spacing: .04em; }\n  @media (max-width: 900px) {\n    .vrl-benefits__grid { grid-template-columns: repeat(2, 1fr); }\n    .vrl-editorial__grid, .vrl-formula__grid, .vrl-faq__grid { grid-template-columns: 1fr; }\n    .vrl-editorial__media, .vrl-editorial__media img { min-height: 480px; }\n    .vrl-formula__media { order: -1; }\n  }\n  @media (max-width: 680px) {\n    .vrl-shell { width: min(100% - 28px, 1180px); }\n    .vrl-trust__grid { grid-template-columns: 1fr; }\n    .vrl-trust__item { padding: 14px; }\n    .vrl-trust__item + .vrl-trust__item { border-left: 0; border-top: 1px solid rgba(31,61,43,.14); }\n    .vrl-editorial__media, .vrl-editorial__media img, .vrl-formula__media, .vrl-formula__media img { min-height: 400px; }\n    .vrl-benefits__grid, .vrl-ritual__grid { grid-template-columns: 1fr; }\n    .vrl-benefit { min-height: 0; }\n    .vrl-ritual__grid { border-top: 0; }\n    .vrl-step { padding: 27px 8px; border-top: 1px solid rgba(251,249,245,.22); }\n    .vrl-step + .vrl-step { border-left: 0; }\n  }\n</style>\n\n{%- assign ritual_image = product.images[1] | default: product.featured_image -%}\n{%- assign formula_image = product.images[2] | default: product.featured_image -%}\n\n<div class=\"vrl-story\">\n  <div class=\"vrl-trust\">\n    <div class=\"vrl-shell vrl-trust__grid\">\n      <div class=\"vrl-trust__item\">Nettoyage ciblé des pieds</div>\n      <div class=\"vrl-trust__item\">Tea Tree + Menthe + Aloe vera</div>\n      <div class=\"vrl-trust__item\">Fraîcheur &amp; odeurs</div>\n    </div>\n  </div>\n\n  \n  \n\n  <section class=\"vrl-editorial\">\n    <div class=\"vrl-shell vrl-editorial__grid\">\n      <div class=\"vrl-editorial__media\">\n        {%- if ritual_image != blank -%}\n          <img src=\"{{ ritual_image | image_url: width: 1500 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\" width=\"{{ ritual_image.width }}\" height=\"{{ ritual_image.height }}\">\n        {%- endif -%}\n      </div>\n      <div class=\"vrl-editorial__copy\">\n        <p class=\"vrl-eyebrow\">Le rituel Verline</p>\n        <h2>Le soin des pieds, enfin à sa place.</h2>\n        <p class=\"vrl-lead\">Chaleur, transpiration et chaussures fermées mettent les pieds à l’épreuve. Verline transforme le nettoyage quotidien en un rituel simple qui rend aux pieds une sensation de netteté.</p>\n        <span class=\"vrl-signature\">Des pieds nets. Une confiance retrouvée</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"vrl-benefits\">\n    <div class=\"vrl-shell\">\n      <div class=\"vrl-section-head\">\n        <p class=\"vrl-eyebrow\">La différence du gel</p>\n        <h2>Une action ciblée, pensée dans les moindres détails.</h2>\n        <p>Une texture gel facile à doser et une formule qui nettoie en profondeur, aide à neutraliser les odeurs et laisse une fraîcheur nette.</p>\n      </div>\n      <div class=\"vrl-benefits__grid\">\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">01</span>\n          <h3>Nettoyage en profondeur</h3>\n          <p>La formule nettoie les pieds et les zones qui transpirent.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">02</span>\n          <h3>Fraîcheur &amp; odeurs</h3>\n          <p>La menthe poivrée apporte une sensation fraîche, tandis que la formule aide à neutraliser les odeurs tenaces.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">03</span>\n          <h3>Rinçage simple</h3>\n          <p>Une mousse facile à travailler pour un rituel rapide sous la douche.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">04</span>\n          <h3>Format compact</h3>\n          <p>100 ml, pour intégrer facilement le soin à la salle de bain ou au sac de voyage.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- VRL_EXACT_START -->\n<section class=\"vrl-exact\" id=\"contenu-commande\" aria-labelledby=\"vrl-exact-title\">\n  <div class=\"vrl-shell\">\n    <div class=\"vrl-section-head\">\n      <p class=\"vrl-eyebrow\">Ce que vous recevez</p>\n      <h2 id=\"vrl-exact-title\">Le produit, sans zone d’ombre.</h2>\n      <p>Chaque détail utile doit pouvoir être compris avant de commander.</p>\n    </div>\n    <div class=\"vrl-exact__grid\">\n      <article class=\"vrl-exact__card\"><b>Dans la commande</b><p>Un flacon de gel lavant pieds et corps au format 100 ml.</p></article>\n      <article class=\"vrl-exact__card\"><b>Texture</b><p>Un gel facile à doser, à faire mousser puis à rincer soigneusement.</p></article>\n      <article class=\"vrl-exact__card\"><b>Informations</b><p>Le mode d’emploi, la liste INCI et les précautions figurant sur l’emballage reçu font foi.</p></article>\n    </div>\n    <p class=\"vrl-formula__note\">Les accessoires décoratifs éventuellement visibles dans les photographies ne sont pas inclus.</p>\n  </div>\n</section>\n<!-- VRL_EXACT_END -->\n\n  <section class=\"vrl-ritual\">\n    <div class=\"vrl-shell\">\n      <p class=\"vrl-eyebrow\" style=\"color:#FBF9F5;text-align:center;\">Le geste juste</p>\n      <h2>Quatre étapes pour un rituel précis.</h2>\n      <div class=\"vrl-ritual__grid\">\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">01</span>\n          <h3>Humidifier</h3>\n          <p>Mouillez la peau, puis déposez une petite quantité de gel.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">02</span>\n          <h3>Faire mousser</h3>\n          <p>Massez délicatement les pieds, notamment entre les orteils.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">03</span>\n          <h3>Rincer</h3>\n          <p>Rincez soigneusement jusqu’à éliminer toute la mousse.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">04</span>\n          <h3>Sécher</h3>\n          <p>Séchez bien la peau, sans oublier les espaces entre les orteils.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"vrl-formula\" id=\"composition\">\n    <div class=\"vrl-shell vrl-formula__grid\">\n      <div class=\"vrl-formula__copy\">\n        <p class=\"vrl-eyebrow\">Une promesse sans détour</p>\n        <h2>Tea Tree. Menthe poivrée. Aloe vera.</h2>\n        <p class=\"vrl-lead\">Le gel lavant Verline nettoie en profondeur, aide à neutraliser les mauvaises odeurs et laisse une sensation de fraîcheur et de confort.</p>\n        <p class=\"vrl-lead\">Un geste simple, à intégrer à votre routine quotidienne.</p>\n        <p class=\"vrl-formula__note\">La liste INCI complète figurant sur l’emballage fait foi. Lisez-la avant utilisation, notamment en cas de sensibilité connue à un ingrédient.</p>\n      </div>\n      <div class=\"vrl-formula__media\">\n        {%- if formula_image != blank -%}\n          <img src=\"{{ formula_image | image_url: width: 1500 }}\" alt=\"Gel lavant Verline Tea Tree, menthe poivrée et aloe vera\" loading=\"lazy\" width=\"{{ formula_image.width }}\" height=\"{{ formula_image.height }}\">\n        {%- endif -%}\n      </div>\n    </div>\n  </section>\n\n  <!-- VRL_PROOF_START -->\n<section class=\"vrl-proof\" id=\"transparence\" aria-labelledby=\"vrl-proof-title\">\n  <div class=\"vrl-shell\">\n    <p class=\"vrl-eyebrow\" style=\"color:#FBF9F5;\">Transparence Verline</p>\n    <h2 id=\"vrl-proof-title\">La confiance ne tient pas dans un badge. Elle tient dans les détails.</h2>\n    <div class=\"vrl-proof__facts\">\n      <div class=\"vrl-proof__fact\"><span>Format</span><b>100 ml</b></div>\n      <div class=\"vrl-proof__fact\"><span>Texture</span><b>Gel lavant</b></div>\n      <div class=\"vrl-proof__fact\"><span>Usage présenté</span><b>Pieds &amp; corps</b></div>\n      <div class=\"vrl-proof__fact\"><span>Au cœur de la formule</span><b>Tea Tree, menthe, aloe vera</b></div>\n    </div>\n    <p class=\"vrl-proof__note\">Aucun résultat chiffré, label, recommandation professionnelle ou note client n’est affiché sans donnée correspondante. La composition et les précautions de l’étiquette restent la référence avant utilisation.</p>\n  </div>\n</section>\n\n<!-- VRL_PROOF_END -->\n\n  <section class=\"vrl-faq\" id=\"faq-produit\">\n    <div class=\"vrl-shell vrl-faq__grid\">\n      <div class=\"vrl-faq__intro\">\n        <p class=\"vrl-eyebrow\">Questions fréquentes</p>\n        <h2>Tout savoir avant votre rituel.</h2>\n        <p>Des réponses simples pour agir avec régularité.</p>\n      </div>\n      <div>\n        <details>\n          <summary>Comment utiliser le gel lavant Verline ?</summary>\n          <p>Sur peau humide, appliquez une petite quantité, faites mousser, puis rincez soigneusement. Pour les pieds, séchez avec attention entre les orteils.</p>\n        </details>\n        <details>\n          <summary>Peut-on l’utiliser sur le corps ?</summary>\n          <p>Le produit est présenté comme un gel lavant pieds et corps. Respectez toujours les indications de l’emballage et évitez le contact avec les yeux et les muqueuses.</p>\n        </details>\n        <details>\n          <summary>Est-ce un traitement ?</summary>\n          <p>Non. Verline est un gel lavant cosmétique destiné à l’hygiène quotidienne : il nettoie, purifie et rafraîchit. Il ne traite aucune affection. En cas de gêne persistante, de lésion ou de doute, demandez conseil à un professionnel de santé.</p>\n        </details>\n        <details>\n          <summary>Que faire si ma peau est sensible ?</summary>\n          <p>Consultez la liste d’ingrédients, testez d’abord sur une petite zone et cessez l’utilisation en cas d’inconfort ou d’irritation.</p>\n        </details>\n        <details>\n          <summary>Quels sont les délais de livraison ?</summary>\n          <p>Le délai estimé est indiqué au moment de la commande et rappelé dans la confirmation. Un numéro de suivi est transmis dès l’expédition.</p>\n        </details>\n        <details>\n          <summary>Puis-je retourner ma commande ?</summary>\n          <p>Les retours sont possibles sous 14 jours, conformément aux conditions de retour de la boutique. Pour un produit cosmétique, l’éligibilité dépend notamment de son état et de son scellement.</p>\n        </details>\n        <details>\n          <summary>Que contient ma commande ?</summary>\n          <p>La commande contient un flacon de gel lavant Verline de 100 ml. Les accessoires décoratifs éventuellement visibles dans les photographies ne sont pas inclus.</p>\n        </details>\n        <details>\n          <summary>Quels moyens de paiement sont proposés ?</summary>\n          <p>Seuls les moyens de paiement réellement activés pour la boutique sont affichés au panier et lors du paiement sécurisé.</p>\n        </details>\n        <details>\n          <summary>Comment contacter Verline ?</summary>\n          <p>Utilisez le <a href=\"{{ routes.root_url }}#contact\">formulaire de contact Verline</a> pour toute question avant ou après commande.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"vrl-final\">\n    <div class=\"vrl-shell vrl-final__inner\">\n      <p class=\"vrl-eyebrow\">Votre nouveau rituel</p>\n      <h2>Des pieds nets, chaque jour.</h2>\n      <p class=\"vrl-final__text\">Choisissez le gel lavant Verline pour nettoyer, purifier les pieds et retrouver une fraîcheur durable.</p>\n      <a class=\"vrl-buy\" href=\"#verline-buy\">Choisir mon gel — {{ product.price | money }}</a>\n      <p class=\"vrl-final__meta\">Paiement sécurisé • Expédition suivie</p>\n    </div>\n  </section>\n\n  <!-- VRL_STICKY_START -->\n  <div class=\"vrl-sticky\" data-vrl-sticky hidden aria-hidden=\"true\">\n    <div class=\"vrl-sticky__meta\"><b>Gel lavant Verline</b><span>100 ml · {{ product.price | money }}</span></div>\n    <button class=\"vrl-sticky__button\" type=\"button\" data-vrl-sticky-button {% unless product.available %}disabled aria-disabled=\"true\"{% endunless %}>{% if product.available %}Ajouter au panier{% else %}Indisponible{% endif %}</button>\n  </div>\n  <script>\n  (() => {\n    const bar = document.querySelector('[data-vrl-sticky]');\n    if (!bar || bar.dataset.ready === 'true') return;\n    bar.dataset.ready = 'true';\n    const stickyButton = bar.querySelector('[data-vrl-sticky-button]');\n    const nativeButton = () => document.querySelector('[id^=\"MainProduct-\"] button[name=\"add\"]');\n    let scheduled = false;\n  \n    const sync = () => {\n      scheduled = false;\n      const native = nativeButton();\n      if (!native) {\n        bar.hidden = true;\n        bar.setAttribute('aria-hidden', 'true');\n        document.body.classList.remove('vrl-sticky-visible');\n        return;\n      }\n      const rect = native.getBoundingClientRect();\n      const nativeVisible = rect.top < window.innerHeight && rect.bottom > 0;\n      const show = window.innerWidth <= 749 && window.scrollY > 160 && !nativeVisible;\n      const disabled = native.disabled || native.getAttribute('aria-disabled') === 'true';\n      stickyButton.disabled = disabled;\n      stickyButton.setAttribute('aria-disabled', String(disabled));\n      bar.hidden = !show;\n      bar.setAttribute('aria-hidden', String(!show));\n      document.body.classList.toggle('vrl-sticky-visible', show);\n    };\n  \n    const requestSync = () => {\n      if (scheduled) return;\n      scheduled = true;\n      requestAnimationFrame(sync);\n    };\n  \n    stickyButton.addEventListener('click', () => {\n      const native = nativeButton();\n      if (native && !native.disabled) native.click();\n    });\n    window.addEventListener('scroll', requestSync, { passive: true });\n    window.addEventListener('resize', requestSync, { passive: true });\n    new MutationObserver(requestSync).observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['disabled', 'aria-disabled'] });\n    sync();\n  })();\n  </script>\n  <!-- VRL_STICKY_END -->\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
