        "bundle_offer": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .vrl-native-quantity--managed { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip-path: inset(50%) !important; white-space: nowrap !important; }\n  .vrl-bundles { margin: 20px 0 16px; font-family: \"DM Sans\", system-ui, sans-serif; }\n  .vrl-bundles fieldset { margin: 0; padding: 0; border: 0; }\n  .vrl-bundles legend { margin: 0 0 11px; color: #1A1A18; font-size: 13px; font-weight: 750; letter-spacing: .015em; }\n  .vrl-bundles__list { display: grid; gap: 10px; }\n  .vrl-offer { position: relative; display: block; cursor: pointer; }\n  .vrl-offer > input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n  .vrl-offer__card { position: relative; display: grid; grid-template-columns: 82px minmax(0,1fr) auto; align-items: center; gap: 14px; min-height: 88px; padding: 12px 14px; border: 1px solid rgba(31,61,43,.18); border-radius: 4px; color: #1A1A18; background: #FBF9F5; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }\n  .vrl-offer:hover .vrl-offer__card { border-color: rgba(31,61,43,.42); transform: translateY(-1px); }\n  .vrl-offer > input:checked + .vrl-offer__card { border: 2px solid #1F3D2B; padding: 11px 13px; background: #F5F1E9; box-shadow: 0 10px 30px rgba(31,61,43,.10); }\n  .vrl-offer > input:focus-visible + .vrl-offer__card { outline: 3px solid #1F3D2B; outline-offset: 3px; }\n  .vrl-offer__visual { position: relative; display: block; width: 78px; height: 62px; }\n  .vrl-offer__visual img { position: absolute; top: 50%; left: 50%; width: 49px; height: 58px; object-fit: contain; border: 1px solid rgba(31,61,43,.12); border-radius: 2px; background: #EFEAE1; box-shadow: 0 5px 12px rgba(26,26,24,.09); transform: translate(-50%,-50%); }\n  .vrl-offer__visual--2 img:first-child { transform: translate(-70%,-50%) rotate(-3deg); }\n  .vrl-offer__visual--2 img:last-child { transform: translate(-30%,-50%) rotate(3deg); }\n  .vrl-offer__visual--3 img:nth-child(1) { transform: translate(-82%,-50%) rotate(-5deg); }\n  .vrl-offer__visual--3 img:nth-child(2) { z-index: 2; transform: translate(-50%,-53%); }\n  .vrl-offer__visual--3 img:nth-child(3) { transform: translate(-18%,-50%) rotate(5deg); }\n  .vrl-offer__copy b, .vrl-offer__copy span, .vrl-offer__price strong, .vrl-offer__price small { display: block; }\n  .vrl-offer__copy b { color: #1F3D2B; font-size: 15px; line-height: 1.25; }\n  .vrl-offer__copy span { margin-top: 5px; color: #5C5C55; font-size: 12px; line-height: 1.35; }\n  .vrl-offer__price { min-width: 82px; text-align: right; }\n  .vrl-offer__price strong { color: #1A1A18; font-family: \"Playfair Display\", Georgia, serif; font-size: 19px; font-weight: 650; white-space: nowrap; }\n  .vrl-offer__price small { margin-top: 4px; color: #5C5C55; font-size: 10px; white-space: nowrap; }\n  .vrl-offer__price s { display: block; margin-bottom: 2px; color: #5C5C55; font-size: 11px; text-decoration-thickness: 1px; }\n  .vrl-offer__saving { display: block; margin-top: 4px; color: #1F3D2B; font-size: 10px; font-weight: 800; white-space: nowrap; }\n  .vrl-offer__badge { position: absolute; z-index: 3; top: -9px; left: 104px; padding: 4px 9px; border-radius: 999px; color: #FBF9F5; background: #1F3D2B; font-size: 9px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }\n  .vrl-bundles__note { margin: 9px 2px 0; color: #5C5C55; font-size: 11px; line-height: 1.45; }\n  @media (max-width: 480px) {\n    .vrl-offer__card { grid-template-columns: 68px minmax(0,1fr) auto; gap: 10px; padding-inline: 10px; }\n    .vrl-offer > input:checked + .vrl-offer__card { padding-inline: 9px; }\n    .vrl-offer__visual { width: 64px; }\n    .vrl-offer__visual img { width: 43px; height: 53px; }\n    .vrl-offer__copy b { font-size: 14px; }\n    .vrl-offer__copy span { font-size: 10px; }\n    .vrl-offer__price { min-width: 70px; }\n    .vrl-offer__price strong { font-size: 17px; }\n    .vrl-offer__badge { left: 78px; }\n  }\n  @media (prefers-reduced-motion: reduce) { .vrl-offer__card { transition: none; } }\n</style>\n\n<div class=\"vrl-bundles\" id=\"vrlBundles-{{ section.id }}\" data-vrl-bundles>\n  <fieldset>\n    <legend>Choisissez votre rituel</legend>\n    <div class=\"vrl-bundles__list\">\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"1\" data-total=\"{{ product.price | money | escape }}\" checked>\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__visual\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"eager\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>1 flacon</b><span>Pour découvrir le rituel Verline</span></span>\n          <span class=\"vrl-offer__price\"><strong>{{ product.price | money }}</strong><small>{{ product.price | money }} / flacon</small></span>\n        </span>\n      </label>\n\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"2\" data-total=\"{{ product.price | times: 2 | money | escape }}\">\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__badge\">Notre suggestion</span>\n          <span class=\"vrl-offer__visual vrl-offer__visual--2\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>2 flacons</b><span>Le duo pratique, en une seule commande</span></span>\n          <span class=\"vrl-offer__price\"><strong>{{ product.price | times: 2 | money }}</strong><small>{{ product.price | money }} / flacon</small></span>\n        </span>\n      </label>\n\n      <label class=\"vrl-offer\">\n        <input type=\"radio\" name=\"vrl-bundle-{{ section.id }}\" value=\"3\" data-total=\"{{ product.price | times: 3 | money | escape }}\">\n        <span class=\"vrl-offer__card\">\n          <span class=\"vrl-offer__visual vrl-offer__visual--3\" aria-hidden=\"true\">\n            {%- if product.featured_image != blank -%}<img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\"><img src=\"{{ product.featured_image | image_url: width: 180 }}\" alt=\"\" width=\"90\" height=\"108\" loading=\"lazy\">{%- endif -%}\n          </span>\n          <span class=\"vrl-offer__copy\"><b>3 flacons</b><span>La réserve complète, sans rupture de routine</span></span>\n          <span class=\"vrl-offer__price\"><strong>{{ product.price | times: 3 | money }}</strong><small>{{ product.price | money }} / flacon</small></span>\n        </span>\n      </label>\n    </div>\n  </fieldset>\n</div>\n\n<script>\n(() => {\n  const root = document.getElementById('vrlBundles-{{ section.id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const boot = () => {\n    const quantity = document.querySelector('#Quantity-Form-{{ section.id }} input[name=\"quantity\"]') || document.querySelector('input[name=\"quantity\"][form^=\"product-form-\"]');\n    const radios = Array.from(root.querySelectorAll('input[type=\"radio\"]'));\n    if (!quantity || !radios.length) return;\n\n    const nativeQuantity = quantity.closest('.product-form__quantity, [id^=\"Quantity-Form-\"]');\n    if (nativeQuantity && !root.contains(nativeQuantity)) {\n      nativeQuantity.classList.add('vrl-native-quantity--managed');\n      nativeQuantity.setAttribute('aria-hidden', 'true');\n      quantity.tabIndex = -1;\n    }\n\n    const render = (radio, dispatch) => {\n      const qty = Math.max(1, parseInt(radio.value, 10) || 1);\n      const total = radio.dataset.total || '';\n      quantity.value = String(qty);\n      if (dispatch) {\n        quantity.dispatchEvent(new Event('input', { bubbles: true }));\n        quantity.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n      const updatePurchaseLabels = () => {\n        const atcPrice = document.getElementById('main-atc-price-{{ section.id }}');\n        if (atcPrice) atcPrice.textContent = total + ' •';\n        const stickyMeta = document.querySelector('[data-vrl-sticky] .vrl-sticky__meta span');\n        if (stickyMeta) stickyMeta.textContent = qty + (qty > 1 ? ' flacons · ' : ' flacon · ') + total;\n      };\n      updatePurchaseLabels();\n      window.setTimeout(updatePurchaseLabels, 80);\n    };\n\n    root.addEventListener('change', (event) => {\n      if (event.target.matches('input[type=\"radio\"]')) render(event.target, true);\n    });\n    quantity.addEventListener('change', () => {\n      const match = radios.find((radio) => radio.value === String(quantity.value));\n      if (match) {\n        match.checked = true;\n        render(match, false);\n      }\n    });\n    render(radios.find((radio) => radio.checked) || radios[0], false);\n  };\n\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });\n  else boot();\n})();\n</script>\n"
          }
        }
      },
      "block_order": [
        "kicker",
