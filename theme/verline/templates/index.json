  <table>\n        <thead><tr><th></th><th class=\"vl-us\">Verline</th><th>Nettoyant généraliste</th></tr></thead>\n        <tbody>\n          <tr><td>Texture</td><td class=\"vl-us vl-y\">Gel facile à doser</td><td class=\"vl-n\">Variable</td></tr>\n          <tr><td>Actifs mis en avant</td><td class=\"vl-us vl-y\">Tea Tree, menthe, aloe vera</td><td class=\"vl-n\">Dépend de la formule</td></tr>\n          <tr><td>Usage</td><td class=\"vl-us vl-y\">Pieds et corps</td><td class=\"vl-n\">Usage général</td></tr>\n          <tr><td>Mycoses et champignons</td><td class=\"vl-us vl-y\">Action ciblée pour les éliminer</td><td class=\"vl-n\">Aucune action ciblée</td></tr>\n          <tr><td>Odeurs</td><td class=\"vl-us vl-y\">Aide à les neutraliser</td><td class=\"vl-n\">Dépend de la formule</td></tr>\n          <tr><td>Format</td><td class=\"vl-us vl-y\">100 ml</td><td class=\"vl-n\">Variable</td></tr>\n        </tbody>\n      </table>\n    </div>\n    {%- if p != blank -%}<div class=\"vl-cp__cta\"><a href=\"{{ p.url }}\">Voir le produit — {{ p.price | money }}</a></div>{%- endif -%}\n  </div>\n</section>"
