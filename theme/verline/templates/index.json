        "custom_liquid": "{% assign verline_product = all_products['gel-lavant-purifiant-pieds-tea-tree'] %}\n{% assign verline_product_url = verline_product.url | default: '/products/gel-lavant-purifiant-pieds-tea-tree' %}\n<style>\n  .vl-premium {\n    --vl-green: #1F3D2B;\n    --vl-amber: #A85C2A;\n    --vl-amber-hover: #8E4C21;\n    --vl-ivory: #FBF9F5;\n    --vl-sand: #EFEAE1;\n    --vl-ink: #1A1A18;\n    --vl-copy: #3A3A36;\n    --vl-muted: #5C5C55;\n    color: var(--vl-ink);\n    background: var(--vl-ivory);\n    font-family: \"DM Sans\", sans-serif;\n  }\n\n  .vl-premium *, .vl-premium *::before, .vl-premium *::after { box-sizing: border-box; }\n  .vl-premium__section { padding: clamp(4.5rem, 8vw, 8rem) 1.25rem; }\n  .vl-premium__section--sand { background: var(--vl-sand); }\n  .vl-premium__section--green { background: var(--vl-green); color: var(--vl-ivory); }\n  .vl-premium__inner { width: min(1160px, 100%); margin-inline: auto; }\n  .vl-premium__inner--narrow { width: min(820px, 100%); }\n  .vl-premium__eyebrow {\n    margin: 0 0 1rem;\n    color: var(--vl-green);\n    font-size: .76rem;\n    font-weight: 700;\n    letter-spacing: .16em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n  .vl-premium__section--green .vl-premium__eyebrow { color: var(--vl-ivory); opacity: .78; }\n  .vl-premium__title {\n    max-width: 820px;\n    margin: 0;\n    color: inherit;\n    font-family: \"Playfair Display\", serif;\n    font-size: clamp(2.1rem, 4.7vw, 4.4rem);\n    font-weight: 500;\n    letter-spacing: -.035em;\n    line-height: 1.04;\n  }\n  .vl-premium__intro {\n    max-width: 680px;\n    margin: 1.35rem 0 0;\n    color: var(--vl-copy);\n    font-size: clamp(1rem, 1.5vw, 1.16rem);\n    line-height: 1.75;\n  }\n  .vl-premium__section--green .vl-premium__intro { color: var(--vl-ivory); opacity: .84; }\n  .vl-premium__grid { display: grid; gap: 1rem; margin-top: 2.75rem; }\n  .vl-premium__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .vl-premium__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .vl-premium__card {\n    min-height: 100%;\n    padding: clamp(1.4rem, 2.5vw, 2rem);\n    border: 1px solid rgba(31, 61, 43, .16);\n    border-radius: 2px;\n    background: var(--vl-ivory);\n  }\n  .vl-premium__index {\n    display: inline-grid;\n    width: 2.5rem;\n    height: 2.5rem;\n    margin-bottom: 2.5rem;\n    place-items: center;\n    border: 1px solid rgba(31, 61, 43, .25);\n    border-radius: 50%;\n    color: var(--vl-green);\n    font-size: .76rem;\n    font-weight: 700;\n    letter-spacing: .08em;\n  }\n  .vl-premium__card h3 {\n    margin: 0 0 .7rem;\n    color: var(--vl-ink);\n    font-family: \"Playfair Display\", serif;\n    font-size: clamp(1.35rem, 2vw, 1.72rem);\n    font-weight: 500;\n    line-height: 1.15;\n  }\n  .vl-premium__card p { margin: 0; color: var(--vl-copy); line-height: 1.65; }\n  .vl-premium__note { margin: 1.5rem 0 0; color: var(--vl-muted); font-size: .86rem; line-height: 1.6; }\n  .vl-premium__text-link {\n    color: var(--vl-green);\n    font-weight: 700;\n    text-decoration-color: rgba(31, 61, 43, .38);\n    text-underline-offset: .25em;\n  }\n  .vl-premium__text-link:hover { text-decoration-color: currentColor; }\n\n  .vl-premium__steps { counter-reset: vl-step; list-style: none; padding: 0; }\n  .vl-premium__steps .vl-premium__card { counter-increment: vl-step; }\n  .vl-premium__steps .vl-premium__index::before { content: \"0\" counter(vl-step); }\n\n  .vl-premium__facts {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    margin-top: 2.75rem;\n    border-top: 1px solid rgba(251, 249, 245, .23);\n    border-bottom: 1px solid rgba(251, 249, 245, .23);\n  }\n  .vl-premium__fact { padding: 1.5rem; border-right: 1px solid rgba(251, 249, 245, .23); }\n  .vl-premium__fact:last-child { border-right: 0; }\n  .vl-premium__fact dt { margin-bottom: .45rem; font-size: .72rem; font-weight: 700; letter-spacing: .12em; opacity: .7; text-transform: uppercase; }\n  .vl-premium__fact dd { margin: 0; font-family: \"Playfair Display\", serif; font-size: 1.25rem; line-height: 1.3; }\n  .vl-premium__principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin: 2.25rem 0 0; }\n  .vl-premium__principle { margin: 0; padding-top: 1.2rem; border-top: 1px solid rgba(251, 249, 245, .23); color: var(--vl-ivory); line-height: 1.65; opacity: .84; }\n  .vl-premium__principle strong { display: block; margin-bottom: .4rem; color: var(--vl-ivory); opacity: 1; }\n\n  .vl-premium__reviews {\n    display: grid;\n    grid-template-columns: minmax(0, .8fr) minmax(300px, 1.2fr);\n    gap: clamp(2rem, 6vw, 6rem);\n    align-items: center;\n  }\n  .vl-premium__review-panel { padding: clamp(1.7rem, 4vw, 3.2rem); border: 1px solid rgba(31, 61, 43, .17); background: var(--vl-ivory); }\n  .vl-premium__review-kicker { margin: 0 0 1rem; color: var(--vl-green); font-size: .78rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n  .vl-premium__review-panel h3 { margin: 0; font-family: \"Playfair Display\", serif; font-size: clamp(1.65rem, 3vw, 2.5rem); font-weight: 500; line-height: 1.15; }\n  .vl-premium__review-panel p { margin: 1rem 0 0; color: var(--vl-copy); line-height: 1.7; }\n\n  .vl-premium__manifesto { text-align: center; }\n  .vl-premium__manifesto .vl-premium__title, .vl-premium__manifesto .vl-premium__intro { margin-inline: auto; }\n  .vl-premium__quote {\n    max-width: 960px;\n    margin: 3rem auto 0;\n    padding: 2rem 0 0;\n    border-top: 1px solid rgba(31, 61, 43, .18);\n    color: var(--vl-green);\n    font-family: \"Playfair Display\", serif;\n    font-size: clamp(1.4rem, 3vw, 2.5rem);\n    line-height: 1.3;\n  }\n\n  .vl-premium__final { text-align: center; }\n  .vl-premium__final .vl-premium__title, .vl-premium__final .vl-premium__intro { margin-inline: auto; }\n  .vl-premium__buy {\n    display: inline-flex;\n    min-height: 3.5rem;\n    margin-top: 2rem;\n    padding: .95rem 1.6rem;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--vl-amber);\n    border-radius: 2px;\n    background: var(--vl-amber);\n    color: var(--vl-ivory);\n    font-weight: 700;\n    line-height: 1.2;\n    text-decoration: none;\n    transition: background-color .18s ease, border-color .18s ease, transform .18s ease;\n  }\n  .vl-premium__buy:hover { border-color: var(--vl-amber-hover); background: var(--vl-amber-hover); color: var(--vl-ivory); transform: translateY(-1px); }\n  .vl-premium__buy:focus-visible, .vl-premium__text-link:focus-visible { outline: 3px solid var(--vl-green); outline-offset: 4px; }\n  .vl-premium__microcopy { margin: .85rem 0 0; color: var(--vl-muted); font-size: .82rem; }\n\n  @media (max-width: 900px) {\n    .vl-premium__grid--3, .vl-premium__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .vl-premium__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .vl-premium__fact:nth-child(2) { border-right: 0; }\n    .vl-premium__fact:nth-child(-n+2) { border-bottom: 1px solid rgba(251, 249, 245, .23); }\n    .vl-premium__reviews { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 620px) {\n    .vl-premium__section { padding-inline: 1rem; }\n    .vl-premium__grid--3, .vl-premium__grid--4, .vl-premium__principles { grid-template-columns: 1fr; }\n    .vl-premium__index { margin-bottom: 1.8rem; }\n    .vl-premium__facts { grid-template-columns: 1fr; }\n    .vl-premium__fact { border-right: 0; border-bottom: 1px solid rgba(251, 249, 245, .23); }\n    .vl-premium__fact:last-child { border-bottom: 0; }\n    .vl-premium__buy { width: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .vl-premium__buy { transition: none; }\n  }\n.vl-premium__contact{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(2rem,7vw,5.5rem);align-items:start}.vl-premium__form{display:grid;gap:1rem}.vl-premium__form label{display:block;margin-bottom:.4rem;color:var(--vl-ink);font-size:.84rem;font-weight:700}.vl-premium__form input,.vl-premium__form textarea{width:100%;padding:.9rem;border:1px solid rgba(31,61,43,.27);border-radius:0;background:var(--vl-ivory);color:var(--vl-ink);font:inherit}.vl-premium__form textarea{min-height:9rem;resize:vertical}.vl-premium__form input:focus,.vl-premium__form textarea:focus{outline:2px solid var(--vl-green);outline-offset:2px}.vl-premium__send{min-height:3.25rem;padding:.85rem 1.4rem;border:1px solid var(--vl-green);background:var(--vl-green);color:var(--vl-ivory);font:inherit;font-weight:700;cursor:pointer}.vl-premium__send:hover{background:#162e20}.vl-premium__status{padding:1rem;border:1px solid rgba(31,61,43,.2);background:var(--vl-ivory);color:var(--vl-copy)}@media(max-width:900px){.vl-premium__contact{grid-template-columns:1fr}}</style>\n<div class=\"vl-premium\">\n<section class=\"vl-premium__section\" id=\"formule\" aria-labelledby=\"vl-ingredients-title\">\n    <div class=\"vl-premium__inner\">\n      <p class=\"vl-premium__eyebrow\">La formule, en toute simplicité</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-ingredients-title\">Trois ingrédients au cœur du rituel.</h2>\n      <p class=\"vl-premium__intro\">Une formule lavante qui associe le Tea Tree, la menthe poivrée et l’aloe vera dans un gel facile à intégrer à la routine quotidienne.</p>\n\n      <div class=\"vl-premium__grid vl-premium__grid--3\">\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">01</span>\n          <h3>Tea Tree</h3>\n          <p>Son caractère aromatique signe l’identité purifiante du rituel Verline.</p>\n        </article>\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">02</span>\n          <h3>Menthe poivrée</h3>\n          <p>Elle accompagne la sensation de fraîcheur laissée sur la peau après le rinçage.</p>\n        </article>\n        <article class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\">03</span>\n          <h3>Aloe vera</h3>\n          <p>Il complète la formule pour faire du nettoyage un geste agréable au quotidien.</p>\n        </article>\n      </div>\n\n      <p class=\"vl-premium__note\">La liste INCI complète et les précautions d’emploi figurant sur l’emballage font foi. <a class=\"vl-premium__text-link\" href=\"{{ verline_product_url }}#composition\">Voir les informations produit</a>.</p>\n    </div>\n  </section>\n<section class=\"vl-premium__section vl-premium__section--sand\" id=\"rituel\" aria-labelledby=\"vl-ritual-title\">\n    <div class=\"vl-premium__inner\">\n      <p class=\"vl-premium__eyebrow\">Le rituel Verline</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-ritual-title\">Quatre gestes. Quelques instants. Une routine plus nette.</h2>\n\n      <ol class=\"vl-premium__grid vl-premium__grid--4 vl-premium__steps\">\n        <li class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\"></span>\n          <h3>Mouiller</h3>\n          <p>Passez les pieds sous l’eau et préparez la peau au nettoyage.</p>\n        </li>\n        <li class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\"></span>\n          <h3>Masser</h3>\n          <p>Déposez une petite quantité de gel et faites mousser, y compris entre les orteils.</p>\n        </li>\n        <li class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\"></span>\n          <h3>Rincer</h3>\n          <p>Rincez soigneusement jusqu’à éliminer toute trace de produit.</p>\n        </li>\n        <li class=\"vl-premium__card\">\n          <span class=\"vl-premium__index\" aria-hidden=\"true\"></span>\n          <h3>Sécher</h3>\n          <p>Séchez avec attention, particulièrement dans les espaces entre les orteils.</p>\n        </li>\n      </ol>\n      <p class=\"vl-premium__note\">Usage externe. Respectez toujours le mode d’emploi et les précautions figurant sur l’emballage.</p>\n    </div>\n  </section>\n<section class=\"vl-premium__section vl-premium__section--green\" aria-labelledby=\"vl-proof-title\">\n    <div class=\"vl-premium__inner\">\n      <p class=\"vl-premium__eyebrow\">La confiance se mérite</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-proof-title\">Des informations claires, jusque dans les détails.</h2>\n      <p class=\"vl-premium__intro\">Avant d’acheter, vous devez pouvoir comprendre ce que vous recevrez, comment l’utiliser et sur quelles informations repose chaque promesse.</p>\n\n      <dl class=\"vl-premium__facts\">\n        <div class=\"vl-premium__fact\"><dt>Format</dt><dd>100 ml</dd></div>\n        <div class=\"vl-premium__fact\"><dt>Texture</dt><dd>Gel lavant</dd></div>\n        <div class=\"vl-premium__fact\"><dt>Usage</dt><dd>Pieds &amp; corps</dd></div>\n        <div class=\"vl-premium__fact\"><dt>Ingrédients mis en avant</dt><dd>Tea Tree, menthe poivrée, aloe vera</dd></div>\n      </dl>\n\n      <div class=\"vl-premium__principles\">\n        <p class=\"vl-premium__principle\"><strong>Composition lisible</strong>La liste INCI et les précautions seront affichées telles qu’elles figurent sur le produit.</p>\n        <p class=\"vl-premium__principle\"><strong>Avis authentiques</strong>Aucune note ni aucun témoignage ne sera affiché sans retour client réel.</p>\n        <p class=\"vl-premium__principle\"><strong>Preuves traçables</strong>Aucun test, résultat chiffré ou label ne sera avancé sans justificatif correspondant.</p>\n      </div>\n    </div>\n  </section>\n<section class=\"vl-premium__section\" id=\"verline-manifeste\" aria-labelledby=\"vl-manifesto-title\">\n    <div class=\"vl-premium__inner vl-premium__manifesto\">\n      <p class=\"vl-premium__eyebrow\">L’intention Verline</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-manifesto-title\">Prendre soin des pieds sans les reléguer au second plan.</h2>\n      <p class=\"vl-premium__intro\">On pense au visage, aux cheveux, au corps. Les pieds, eux, attendent souvent qu’un inconfort nous rappelle leur importance. Verline leur redonne une place simple dans le quotidien.</p>\n      <p class=\"vl-premium__quote\">« Des gestes précis, une esthétique calme et une information claire : rien de plus que ce qui est utile, rien de moins que ce qui mérite votre confiance. »</p>\n    </div>\n  </section>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "vl_reviews": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign verline_product = all_products['gel-lavant-purifiant-pieds-tea-tree'] %}\n{% assign verline_product_url = verline_product.url | default: '/products/gel-lavant-purifiant-pieds-tea-tree' %}\n<div class=\"vl-premium\">\n<section class=\"vl-premium__section vl-premium__section--sand\" id=\"avis\" aria-labelledby=\"vl-reviews-title\">\n    <div class=\"vl-premium__inner vl-premium__reviews\">\n      <div>\n        <p class=\"vl-premium__eyebrow\">Les retours Verline</p>\n        <h2 class=\"vl-premium__title\" id=\"vl-reviews-title\">Une confiance construite par de vraies expériences.</h2>\n      </div>\n\n      <div class=\"vl-premium__review-panel\" aria-live=\"polite\">\n        {% if verline_product.metafields.reviews.rating.value != blank and verline_product.metafields.reviews.rating_count.value > 0 %}\n          <p class=\"vl-premium__review-kicker\">Avis issus de clients</p>\n          <h3>{{ verline_product.metafields.reviews.rating.value.rating | round: 1 }}/5 — {{ verline_product.metafields.reviews.rating_count.value }} avis</h3>\n          <p>Consultez les retours disponibles sur la fiche produit, y compris les expériences plus nuancées.</p>\n          <p><a class=\"vl-premium__text-link\" href=\"{{ verline_product_url }}#avis-clients\">Lire tous les avis</a></p>\n        {% else %}\n          <p class=\"vl-premium__review-kicker\">Nouveau chez Verline</p>\n          <h3>Les premiers avis s’écrivent maintenant.</h3>\n          <p>Nous n’affichons ni faux témoignage ni note artificielle. Les retours issus d’expériences d’achat réelles apparaîtront ici, positifs comme critiques.</p>\n          <p><a class=\"vl-premium__text-link\" href=\"{{ verline_product_url }}\">Découvrir le rituel</a></p>\n        {% endif %}\n      </div>\n    </div>\n  </section>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "vl_contact": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"vl-premium\">\n<section class=\"vl-premium__section\" id=\"contact\" aria-labelledby=\"vl-contact-title\">\n  <div class=\"vl-premium__inner vl-premium__contact\">\n    <div><p class=\"vl-premium__eyebrow\">Besoin d’aide ?</p><h2 class=\"vl-premium__title\" id=\"vl-contact-title\">Une question avant de choisir Verline ?</h2><p class=\"vl-premium__intro\">Écrivez-nous directement. Votre message sera transmis au service client de la boutique.</p><p class=\"vl-premium__note\">Ne communiquez aucune donnée médicale ou information sensible dans ce formulaire.</p></div>\n    <div>\n      {%- form 'contact', class: 'vl-premium__form' -%}\n        {%- if form.posted_successfully? -%}<p class=\"vl-premium__status\" role=\"status\">Merci. Votre message a bien été envoyé.</p>{%- endif -%}\n        {{ form.errors | default_errors }}\n        <div><label for=\"VlContactName\">Nom</label><input id=\"VlContactName\" name=\"contact[name]\" type=\"text\" autocomplete=\"name\"></div>\n        <div><label for=\"VlContactEmail\">E-mail</label><input id=\"VlContactEmail\" name=\"contact[email]\" type=\"email\" autocomplete=\"email\" required></div>\n        <div><label for=\"VlContactMessage\">Votre message</label><textarea id=\"VlContactMessage\" name=\"contact[body]\" required></textarea></div>\n        <button class=\"vl-premium__send\" type=\"submit\">Envoyer ma question</button>\n      {%- endform -%}\n    </div>\n  </div>\n</section>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "vl_final": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign verline_product = all_products['gel-lavant-purifiant-pieds-tea-tree'] %}\n{% assign verline_product_url = verline_product.url | default: '/products/gel-lavant-purifiant-pieds-tea-tree' %}\n<div class=\"vl-premium\">\n<section class=\"vl-premium__section\" aria-labelledby=\"vl-final-title\">\n    <div class=\"vl-premium__inner vl-premium__inner--narrow vl-premium__final\">\n      <p class=\"vl-premium__eyebrow\">Votre rituel Verline</p>\n      <h2 class=\"vl-premium__title\" id=\"vl-final-title\">Des pieds nets. Une fraîcheur retrouvée. Un geste qui trouve enfin sa place.</h2>\n      <p class=\"vl-premium__intro\">Découvrez le gel lavant Verline et intégrez un soin ciblé des pieds à votre routine quotidienne.</p>\n      <a class=\"vl-premium__buy\" href=\"{{ verline_product_url }}\">Choisir mon gel Verline{% if verline_product.price > 0 %} — {{ verline_product.price | money }}{% endif %}</a>\n      <p class=\"vl-premium__microcopy\">100 ml · Paiement sécurisé · Informations de livraison précisées avant le règlement</p>\n    </div>\n  </section>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
