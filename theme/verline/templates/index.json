ition:relative;line-height:1.5}\n.vl-hero li:before{content:\"\";position:absolute;left:0;top:6px;width:12px;height:7px;border-left:2px solid #1F3D2B;border-bottom:2px solid #1F3D2B;transform:rotate(-45deg)}\n@media(max-width:799px){.vl-hero{padding-top:30px}.vl-hero__copy{order:1}.vl-hero__visual{order:2;min-height:330px}.vl-hero h1{font-size:clamp(36px,11vw,50px)}.vl-hero p.vl-lead{font-size:16px}.vl-cta{max-width:none}}\n@media(min-width:800px){.vl-hero__in{grid-template-columns:1.02fr .98fr;gap:clamp(48px,7vw,92px)}.vl-hero__visual{min-height:620px}.vl-cta{width:auto}.vl-hero ul{grid-template-columns:1fr 1fr}}\n</style>\n<div class=\"vl-hero\" id=\"accueil\">\n  <div class=\"vl-hero__in\">\n    <div class=\"vl-hero__visual\">\n      {%- if p.featured_image -%}\n        <img class=\"vl-hero__img\" src=\"{{ p.featured_image | image_url: width: 1300 }}\" alt=\"Gel lavant Verline Tea Tree, menthe poivrée et aloe vera\" width=\"{{ p.featured_image.width }}\" height=\"{{ p.featured_image.height }}\" loading=\"eager\">\n      {%- endif -%}\n    </div>\n    <div class=\"vl-hero__copy\">\n      <p class=\"vl-eyebrow\">Verline · Rituel antifongique ciblé</p>\n      <h1>Éliminez les mycoses et les champignons des pieds.</h1>\n      <p class=\"vl-lead\">Le gel lavant Verline associe Tea Tree, menthe poivrée et aloe vera pour cibler les champignons responsables des mycoses, aider à neutraliser les mauvaises odeurs et rendre aux pieds une sensation de fraîcheur nette.</p>\n      {%- if p != blank -%}\n        <div class=\"vl-price\"><b>{{ p.price | money }}</b><span>flacon 100 ml · livraison incluse</span></div>\n        <a class=\"vl-cta\" href=\"{{ p.url }}\">Découvrir le rituel Verline</a>\n      {%- endif -%}\n      <ul>\n        <li>Élimine les champignons responsables des mycoses</li>\n        <li>Aide à neutraliser les mauvaises odeurs tenaces</li>\n        <li>Nettoie en profondeur les pieds et le corps</li>\n        <li>Tea Tree, menthe poivrée et aloe vera</li>\n      </ul>\n    </div>\n  </div>\n</div>"
