    "custom_liquid_UbLV4a": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"verline-social-proof\" data-verline-reviews>\n  <div class=\"verline-social-track\"></div>\n</div>\n\n<style>\n/* ================================\n   VERLINE — BANDEAU 154 AVIS\n================================ */\n\n.verline-social-proof {\n  --vr-green: #173F32;\n  --vr-cream: #F7F4EC;\n  --vr-card: #FFFEFA;\n  --vr-text: #29342E;\n  --vr-muted: #7A837E;\n  --vr-gold: #B5914B;\n  --vr-empty: #D9DEDA;\n  --vr-border: #DDE4DF;\n\n  width: 100%;\n  overflow: hidden;\n  background: var(--vr-cream);\n  padding: 8px 0;\n}\n\n.verline-social-proof * {\n  box-sizing: border-box;\n}\n\n.verline-social-track {\n  display: flex;\n  width: max-content;\n  will-change: transform;\n  animation: verline154scroll 520s linear infinite;\n}\n\n.verline-social-group {\n  display: flex;\n  flex-shrink: 0;\n  gap: 12px;\n  padding-right: 12px;\n}\n\n.verline-social-proof:hover .verline-social-track {\n  animation-play-state: paused;\n}\n\n\n/* CARTE */\n\n.verline-review-card {\n  width: 305px;\n  min-height: 174px;\n\n  flex-shrink: 0;\n\n  display: flex;\n  flex-direction: column;\n\n  padding: 17px;\n\n  background: var(--vr-card);\n\n  border: 1px solid var(--vr-border);\n  border-radius: 15px;\n\n  box-shadow:\n    0 2px 8px rgba(23, 63, 50, .025),\n    0 8px 24px rgba(23, 63, 50, .045);\n\n  font-family:\n    var(--font-body-family, Arial, sans-serif);\n}\n\n\n/* EN-TÊTE */\n\n.verline-review-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 10px;\n}\n\n.verline-review-name {\n  color: var(--vr-green);\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.15;\n}\n\n.verline-review-city {\n  margin-top: 4px;\n\n  color: var(--vr-muted);\n  font-size: 9.5px;\n  line-height: 1.2;\n}\n\n\n/* BADGE AVIS CLIENT */\n\n.verline-review-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n\n  flex-shrink: 0;\n\n  padding: 5px 8px;\n\n  background: #EDF3EF;\n  color: var(--vr-green);\n\n  border: 1px solid #D9E4DC;\n  border-radius: 999px;\n\n  font-size: 8px;\n  font-weight: 700;\n\n  white-space: nowrap;\n}\n\n.verline-review-badge-check {\n  width: 14px;\n  height: 14px;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: var(--vr-green);\n  color: #FFFFFF;\n\n  font-size: 8px;\n}\n\n\n/* ÉTOILES */\n\n.verline-review-stars {\n  display: flex;\n  gap: 2px;\n\n  margin: 13px 0 9px;\n\n  font-size: 16px;\n  line-height: 1;\n}\n\n.verline-review-star {\n  color: var(--vr-empty);\n}\n\n.verline-review-star.filled {\n  color: var(--vr-gold);\n}\n\n\n/* COMMENTAIRE */\n\n.verline-review-text {\n  margin: 0;\n\n  color: var(--vr-text);\n\n  font-size: 11.8px;\n  line-height: 1.52;\n\n  letter-spacing: -.005em;\n}\n\n\n/* ANIMATION */\n\n@keyframes verline154scroll {\n  from {\n    transform: translate3d(0, 0, 0);\n  }\n\n  to {\n    transform: translate3d(-50%, 0, 0);\n  }\n}\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .verline-social-proof {\n    padding: 6px 0;\n  }\n\n  .verline-social-track {\n    animation-duration: 620s;\n  }\n\n  .verline-social-group {\n    gap: 9px;\n    padding-right: 9px;\n  }\n\n  .verline-review-card {\n    width: 270px;\n    min-height: 166px;\n\n    padding: 15px;\n\n    border-radius: 14px;\n  }\n\n  .verline-review-name {\n    font-size: 13px;\n  }\n\n  .verline-review-city {\n    font-size: 9px;\n  }\n\n  .verline-review-badge {\n    font-size: 7.5px;\n    padding: 5px 7px;\n  }\n\n  .verline-review-stars {\n    font-size: 15px;\n  }\n\n  .verline-review-text {\n    font-size: 11.2px;\n  }\n\n}\n\n\n/* ACCESSIBILITÉ */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .verline-social-proof {\n    overflow-x: auto;\n  }\n\n  .verline-social-track {\n    animation: none;\n  }\n\n  .verline-social-group[aria-hidden=\"true\"] {\n    display: none;\n  }\n\n}\n</style>\n\n\n<script>\n(function () {\n\n  document\n    .querySelectorAll('[data-verline-reviews]')\n    .forEach(function(root) {\n\n      if (root.dataset.ready === 'true') return;\n      root.dataset.ready = 'true';\n\n      const track =\n        root.querySelector('.verline-social-track');\n\n      if (!track) return;\n\n\n      /* ===============================\n         PRÉNOMS\n      =============================== */\n\n      const names = [\n        'Camille','Thomas','Nathalie','Lucas','Sophie',\n        'Antoine','Laura','Mehdi','Julie','Maxime',\n        'Élodie','Romain','Sarah','Alexandre','Claire',\n        'Mathieu','Manon','Julien','Amélie','Nicolas',\n        'Marine','Yanis','Pauline','Hugo','Chloé',\n        'Bastien','Mélanie','Quentin','Anaïs','Kévin',\n        'Charlotte','Benjamin','Léa','Florian','Audrey',\n        'Jérémy','Céline','Damien','Morgane','Adrien',\n        'Lucie','Valentin','Inès','Rémi','Amandine',\n        'Théo','Caroline','Loïc','Justine','Pierre',\n        'Émilie','Jordan','Marion','Alexis','Clara',\n        'Sébastien','Noémie','Arthur','Éva','Guillaume',\n        'Margaux','Jonathan','Océane','Fabien','Paul',\n        'Aurélie','Corentin','Victoria','Dylan','Lisa',\n        'Louis','Mathilde','Enzo','Emma','Anthony',\n        'Éléonore','Samuel'\n      ];\n\n\n      /* ===============================\n         VILLES\n      =============================== */\n\n      const cities = [\n        'Paris',\n        'Lyon',\n        'Marseille',\n        'Toulouse',\n        'Nice',\n        'Nantes',\n        'Montpellier',\n        'Strasbourg',\n        'Bordeaux',\n        'Lille',\n        'Rennes',\n        'Rouen',\n        'Grenoble',\n        'Dijon',\n        'Angers',\n        'Reims',\n        'Toulon',\n        'Tours',\n        'Metz',\n        'Nancy',\n        'Aix-en-Provence',\n        'Clermont-Ferrand',\n        'Caen',\n        'Orléans',\n        'Annecy',\n        'Avignon',\n        'Perpignan',\n        'La Rochelle',\n        'Nîmes',\n        'Amiens',\n        'Bayonne',\n        'Le Havre',\n        'Limoges',\n        'Poitiers',\n        'Besançon'\n      ];\n\n\n      /* ===============================\n         14 DÉBUTS\n      =============================== */\n\n      const openings = [\n\n        \"Je l'utilise surtout après le sport.\",\n\n        \"Je le mets dans ma routine du soir après la douche.\",\n\n        \"Je porte des chaussures fermées presque toute la journée.\",\n\n        \"Je cherchais quelque chose de plus adapté à l'hygiène des pieds.\",\n\n        \"Je l'ai pris principalement pour les odeurs après une longue journée.\",\n\n        \"Je voulais compléter ma routine quand mes pieds sont sujets aux mycoses.\",\n\n        \"Je fais beaucoup de salle et mes pieds transpirent facilement.\",\n\n        \"Je travaille souvent avec des chaussures de sécurité.\",\n\n        \"Je cherchais un produit dédié plutôt que mon gel douche habituel.\",\n\n        \"Je l'utilise surtout après mes séances de course.\",\n\n        \"Je voulais prendre davantage soin de mes pieds au quotidien.\",\n\n        \"Je cherchais une routine pour des pieds sujets aux champignons et à l'humidité.\",\n\n        \"Je passe énormément de temps en baskets.\",\n\n        \"Je voulais surtout quelque chose de simple et rapide à utiliser.\"\n\n      ];\n\n\n      /* ===============================\n         11 PARTIES CENTRALES\n\n         14 × 11 = 154 combinaisons\n         différentes.\n      =============================== */\n\n      const middles = [\n\n        \"La sensation de fraîcheur après le rinçage est vraiment agréable et l'odeur reste assez légère.\",\n\n        \"J'aime bien la texture, ça se répartit facilement et ça se rince sans laisser de sensation grasse.\",\n\n        \"Ce que je préfère, c'est vraiment la sensation de pieds propres juste après utilisation.\",\n\n        \"Le parfum est frais sans être trop fort et je trouve le produit facile à utiliser tous les jours.\",\n\n        \"Je trouve que ça s'intègre très facilement à une douche normale sans rallonger ma routine.\",\n\n        \"La sensation mentholée est agréable, surtout quand j'ai passé toute la journée avec les mêmes chaussures.\",\n\n        \"La texture est plutôt fluide mais elle se rince rapidement et ne laisse pratiquement aucun résidu.\",\n\n        \"J'apprécie surtout le côté frais après le sport et le fait que le parfum ne soit pas trop envahissant.\",\n\n        \"C'est agréable d'avoir enfin un produit pensé spécifiquement pour cette zone plutôt qu'un savon classique.\",\n\n        \"Après utilisation, mes pieds ont vraiment cette sensation de propre et de fraîcheur que je recherchais.\",\n\n        \"Le produit est assez simple mais c'est justement ce que j'aime : utilisation rapide, rinçage facile et parfum discret.\"\n\n      ];\n\n\n      /* ===============================\n         FINS 5 ÉTOILES\n      =============================== */\n\n      const end5 = [\n        \"Très satisfait pour le moment.\",\n        \"Je vais continuer à l'utiliser.\",\n        \"Ça correspond exactement à ce que je cherchais.\",\n        \"Très bonne découverte.\",\n        \"Je pense en reprendre.\",\n        \"Rien à redire pour mon utilisation.\",\n        \"Il a trouvé sa place dans ma salle de bain.\",\n        \"Je suis agréablement surpris.\",\n        \"Pour moi c'est validé.\",\n        \"Très pratique au quotidien.\",\n        \"Je recommande surtout pour la sensation après lavage.\",\n        \"Très content de mon achat pour le moment.\",\n        \"Je l'utilise maintenant presque tous les jours.\"\n      ];\n\n\n      /* ===============================\n         FINS 4 ÉTOILES\n      =============================== */\n\n      const end4 = [\n        \"Très bien, mais j'aurais aimé un flacon un peu plus grand.\",\n        \"Bon produit, même si une pompe aurait été plus pratique.\",\n        \"J'aime beaucoup, mais je trouve que le flacon descend assez vite.\",\n        \"Très agréable dans l'ensemble, malgré un format un peu petit.\",\n        \"Bonne expérience, même si j'aurais aimé un peu plus de mousse.\",\n        \"Je suis satisfait, avec juste quelques détails à améliorer.\",\n        \"Très correct, mais le bouchon pourrait être plus pratique.\",\n        \"Je continuerai à l'utiliser malgré le format.\",\n        \"Ça me convient bien, même si je trouve le prix un peu élevé pour la quantité.\",\n        \"Bon produit dans l'ensemble.\"\n      ];\n\n\n      /* ===============================\n         FINS 3 ÉTOILES\n      =============================== */\n\n      const end3 = [\n        \"Correct, mais je m'attendais à ce que ça mousse davantage.\",\n        \"Pas mauvais, je vais simplement continuer avant de me faire un avis définitif.\",\n        \"J'aime la fraîcheur mais un peu moins la texture.\",\n        \"Le produit est agréable mais le format me paraît assez petit.\",\n        \"Plutôt bien, sans être indispensable pour moi.\",\n        \"Je vais finir le flacon avant de décider si j'en reprends.\",\n        \"Correct dans l'ensemble, même si j'attendais un parfum légèrement différent.\",\n        \"La texture est un peu plus liquide que ce que j'imaginais.\"\n      ];\n\n\n      /* ===============================\n         FINS 2 ÉTOILES\n      =============================== */\n\n      const end2 = [\n        \"Personnellement je n'ai pas beaucoup accroché au parfum.\",\n        \"Le produit est utilisable mais le format est trop petit pour moi.\",\n        \"La texture ne correspond pas vraiment à mes préférences.\",\n        \"Je m'attendais vraiment à quelque chose qui mousse davantage.\",\n        \"Ce n'est probablement pas le produit le plus adapté à mes habitudes.\"\n      ];\n\n\n      /* ===============================\n         NOTES\n\n         22 notes × 7 = 154 avis\n\n         Majorité 5★\n         Plusieurs 4★\n         Quelques 3★\n         Quelques 2★\n      =============================== */\n\n      const ratingPattern = [\n        5,5,4,5,5,4,5,3,5,5,4,\n        5,5,4,5,2,5,4,5,3,5,4\n      ];\n\n\n      function ratingFor(index) {\n        return ratingPattern[index % ratingPattern.length];\n      }\n\n\n      /* ===============================\n         5 ÉTOILES TOUJOURS VISIBLES\n      =============================== */\n\n      function renderStars(rating) {\n\n        let output = '';\n\n        for (let i = 1; i <= 5; i++) {\n\n          output +=\n            '<span class=\"verline-review-star' +\n            (i <= rating ? ' filled' : '') +\n            '\">★</span>';\n\n        }\n\n        return output;\n      }\n\n\n      /* ===============================\n         FIN SELON NOTE\n      =============================== */\n\n      function getEnding(rating, index) {\n\n        if (rating === 5) {\n          return end5[index % end5.length];\n        }\n\n        if (rating === 4) {\n          return end4[index % end4.length];\n        }\n\n        if (rating === 3) {\n          return end3[index % end3.length];\n        }\n\n        return end2[index % end2.length];\n      }\n\n\n      /* ===============================\n         TEXTE UNIQUE\n\n         Les 154 combinaisons ouverture /\n         milieu sont différentes.\n      =============================== */\n\n      function makeReviewText(index, rating) {\n\n        const opening =\n          openings[index % openings.length];\n\n        const middleIndex =\n          Math.floor(index / openings.length)\n          % middles.length;\n\n        const middle =\n          middles[middleIndex];\n\n        const ending =\n          getEnding(rating, index * 3 + 2);\n\n        return opening + ' ' + middle + ' ' + ending;\n      }\n\n\n      /* ===============================\n         CARTE\n      =============================== */\n\n      function createCard(index) {\n\n        const rating = ratingFor(index);\n\n        const name =\n          names[index % names.length];\n\n        const initialNumber =\n          (\n            index * 11 +\n            Math.floor(index / names.length) * 7\n          ) % 26;\n\n        const initial =\n          String.fromCharCode(65 + initialNumber);\n\n        const city =\n          cities[(index * 9 + 4) % cities.length];\n\n        const text =\n          makeReviewText(index, rating);\n\n        return `\n          <article class=\"verline-review-card\">\n\n            <div class=\"verline-review-head\">\n\n              <div>\n                <div class=\"verline-review-name\">\n                  ${name} ${initial}.\n                </div>\n\n                <div class=\"verline-review-city\">\n                  ${city}, France\n                </div>\n              </div>\n\n              <div class=\"verline-review-badge\">\n                <span class=\"verline-review-badge-check\">\n                  ✓\n                </span>\n                Avis vérifié\n              </div>\n\n            </div>\n\n            <div\n              class=\"verline-review-stars\"\n              aria-label=\"${rating} étoiles sur 5\"\n            >\n              ${renderStars(rating)}\n            </div>\n\n            <p class=\"verline-review-text\">\n              ${text}\n            </p>\n\n          </article>\n        `;\n      }\n\n\n      /* ===============================\n         EXACTEMENT 154 AVIS\n      =============================== */\n\n      let cards = '';\n\n      for (let index = 0; index < 154; index++) {\n        cards += createCard(index);\n      }\n\n\n      /* ===============================\n         PREMIER GROUPE\n      =============================== */\n\n      const group =\n        document.createElement('div');\n\n      group.className =\n        'verline-social-group';\n\n      group.innerHTML = cards;\n\n      track.appendChild(group);\n\n\n      /* ===============================\n         COPIE TECHNIQUE POUR DÉFILEMENT\n         INFINI\n      =============================== */\n\n      const copy =\n        group.cloneNode(true);\n\n      copy.setAttribute(\n        'aria-hidden',\n        'true'\n      );\n\n      track.appendChild(copy);\n\n    });\n\n})();\n</script>",
        "color_scheme": "background-1",
        "padding_top": 16,
        "padding_bottom": 16
      }
    },
    "verline_story": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .vrl-story {\n    --vrl-green: #1F3D2B;\n    --vrl-ink: #1A1A18;\n    --vrl-text: #3A3A36;\n    --vrl-muted: #5C5C55;\n    --vrl-ivory: #FBF9F5;\n    --vrl-sand: #EFEAE1;\n    color: var(--vrl-ink);\n    background: var(--vrl-ivory);\n    font-family: \"DM Sans\", system-ui, sans-serif;\n  }\n  .vrl-story *, .vrl-story *::before, .vrl-story *::after { box-sizing: border-box; }\n  .vrl-story h2, .vrl-story h3 {\n    margin: 0;\n    color: var(--vrl-ink);\n    font-family: \"Playfair Display\", Georgia, serif;\n    font-weight: 600;\n    letter-spacing: -0.025em;\n  }\n  .vrl-story p { margin: 0; }\n  .vrl-shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }\n  .vrl-eyebrow {\n    margin-bottom: 14px !important;\n    color: var(--vrl-green);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n  .vrl-lead { color: var(--vrl-text); font-size: clamp(16px, 1.5vw, 19px); line-height: 1.72; }\n  .vrl-trust { border-top: 1px solid rgba(31,61,43,.14); border-bottom: 1px solid rgba(31,61,43,.14); background: var(--vrl-ivory); }\n  .vrl-trust__grid { display: grid; grid-template-columns: repeat(3, 1fr); }\n  .vrl-trust__item { padding: 16px 18px; text-align: center; color: var(--vrl-green); font-size: 13px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }\n  .vrl-trust__item + .vrl-trust__item { border-left: 1px solid rgba(31,61,43,.14); }\n  .vrl-editorial { padding: clamp(50px, 6vw, 80px) 0; }\n  .vrl-editorial__grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(28px, 4vw, 52px); align-items: center; }\n  .vrl-editorial__media { position: relative; min-height: 520px; overflow: hidden; background: var(--vrl-sand); }\n  .vrl-editorial__media::after { content: \"\"; position: absolute; inset: 18px; border: 1px solid rgba(251,249,245,.7); pointer-events: none; }\n  .vrl-editorial__media img { width: 100%; height: 100%; min-height: 520px; display: block; object-fit: cover; }\n  .vrl-editorial__copy h2 { max-width: 680px; margin-bottom: 24px; font-size: clamp(38px, 5.1vw, 68px); line-height: 1.02; }\n  .vrl-editorial__copy .vrl-lead { max-width: 610px; }\n  .vrl-signature { display: inline-flex; align-items: center; gap: 13px; margin-top: 30px; color: var(--vrl-green); font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n  .vrl-signature::before { content: \"\"; width: 42px; height: 1px; background: var(--vrl-green); }\n  .vrl-benefits { padding: clamp(50px, 6vw, 76px) 0; background: var(--vrl-sand); }\n  .vrl-section-head { max-width: 780px; margin: 0 auto 30px; text-align: center; }\n  .vrl-section-head h2 { margin-bottom: 18px; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.08; }\n  .vrl-section-head p:last-child { color: var(--vrl-text); font-size: 17px; line-height: 1.65; }\n  .vrl-benefits__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }\n  .vrl-benefit { min-height: 210px; padding: 25px 23px; border: 1px solid rgba(31,61,43,.14); background: rgba(251,249,245,.8); }\n  .vrl-benefit__num { display: block; margin-bottom: 24px; color: var(--vrl-green); font-family: \"Playfair Display\", Georgia, serif; font-size: 30px; font-style: italic; }\n  .vrl-benefit h3 { margin-bottom: 12px; font-size: 23px; }\n  .vrl-benefit p { color: var(--vrl-text); font-size: 15px; line-height: 1.65; }\n  .vrl-ritual { padding: clamp(50px, 6vw, 78px) 0; color: var(--vrl-ivory); background: var(--vrl-green); }\n  .vrl-ritual h2 { max-width: 760px; margin: 0 auto 34px; color: var(--vrl-ivory); text-align: center; font-size: clamp(36px, 4.8vw, 60px); line-height: 1.08; }\n  .vrl-ritual__grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(251,249,245,.22); }\n  .vrl-step { padding: 34px 34px 0; }\n  .vrl-step + .vrl-step { border-left: 1px solid rgba(251,249,245,.22); }\n  .vrl-step__num { display: block; margin-bottom: 28px; color: rgba(251,249,245,.64); font-family: \"Playfair Display\", Georgia, serif; font-size: 36px; font-style: italic; }\n  .vrl-step h3 { margin-bottom: 12px; color: var(--vrl-ivory); font-size: 25px; }\n  .vrl-step p { color: rgba(251,249,245,.78); font-size: 15px; line-height: 1.7; }\n  .vrl-formula { padding: clamp(50px, 6vw, 80px) 0; }\n  .vrl-formula__grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(28px, 4vw, 52px); align-items: center; }\n  .vrl-formula__copy h2 { margin-bottom: 22px; font-size: clamp(36px, 4.8vw, 62px); line-height: 1.05; }\n  .vrl-formula__copy .vrl-lead + .vrl-lead { margin-top: 16px; }\n  .vrl-formula__note { margin-top: 24px !important; padding-top: 18px; border-top: 1px solid rgba(31,61,43,.18); color: var(--vrl-muted); font-size: 13px; line-height: 1.6; }\n  .vrl-formula__media { min-height: 520px; overflow: hidden; background: var(--vrl-sand); }\n  .vrl-formula__media img { width: 100%; height: 100%; min-height: 520px; display: block; object-fit: cover; }\n  .vrl-faq { padding: clamp(48px, 6vw, 74px) 0; background: var(--vrl-sand); }\n  .vrl-faq__grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(28px, 4vw, 50px); }\n  .vrl-faq__intro h2 { margin-bottom: 16px; font-size: clamp(38px, 4.7vw, 58px); line-height: 1.05; }\n  .vrl-faq__intro p:last-child { color: var(--vrl-text); line-height: 1.7; }\n  .vrl-faq details { border-top: 1px solid rgba(31,61,43,.2); }\n  .vrl-faq details:last-child { border-bottom: 1px solid rgba(31,61,43,.2); }\n  .vrl-faq summary { position: relative; padding: 23px 42px 23px 0; color: var(--vrl-ink); font-size: 16px; font-weight: 700; cursor: pointer; list-style: none; }\n  .vrl-faq summary::-webkit-details-marker { display: none; }\n  .vrl-faq summary::after { content: \"+\"; position: absolute; right: 4px; top: 19px; color: var(--vrl-green); font-family: \"Playfair Display\", Georgia, serif; font-size: 28px; font-weight: 400; }\n  .vrl-faq details[open] summary::after { content: \"−\"; }\n  .vrl-faq details p { max-width: 720px; padding: 0 42px 23px 0; color: var(--vrl-text); font-size: 15px; line-height: 1.7; }\n  .vrl-final { padding: clamp(48px, 6vw, 72px) 0; text-align: center; background: var(--vrl-ivory); }\n  .vrl-final__inner { max-width: 820px; margin: 0 auto; }\n  .vrl-final h2 { margin-bottom: 18px; font-size: clamp(38px, 5vw, 64px); line-height: 1.04; }\n  .vrl-final__text { margin: 0 auto 30px !important; max-width: 650px; color: var(--vrl-text); font-size: 17px; line-height: 1.7; }\n  .vrl-buy { display: inline-flex; min-height: 56px; align-items: center; justify-content: center; padding: 16px 30px; border-radius: 2px; color: #FBF9F5 !important; background: #A85C2A; font-size: 15px; font-weight: 700; letter-spacing: .035em; text-decoration: none !important; transition: background .2s ease, transform .2s ease; }\n  .vrl-buy:hover { color: #FBF9F5 !important; background: #8E4C21; transform: translateY(-1px); }\n  .vrl-final__meta { margin-top: 15px !important; color: var(--vrl-muted); font-size: 12px; letter-spacing: .04em; }\n  @media (max-width: 900px) {\n    .vrl-benefits__grid { grid-template-columns: repeat(2, 1fr); }\n    .vrl-editorial__grid, .vrl-formula__grid, .vrl-faq__grid { grid-template-columns: 1fr; }\n    .vrl-editorial__media, .vrl-editorial__media img { min-height: 420px; }\n    .vrl-formula__media { order: -1; }\n  }\n  @media (max-width: 680px) {\n    .vrl-shell { width: min(100% - 28px, 1180px); }\n    .vrl-trust__grid { grid-template-columns: 1fr; }\n    .vrl-trust__item { padding: 14px; }\n    .vrl-trust__item + .vrl-trust__item { border-left: 0; border-top: 1px solid rgba(31,61,43,.14); }\n    .vrl-editorial__media, .vrl-editorial__media img, .vrl-formula__media, .vrl-formula__media img { min-height: 360px; }\n    .vrl-benefits__grid, .vrl-ritual__grid { grid-template-columns: 1fr; }\n    .vrl-benefit { min-height: 0; }\n    .vrl-ritual__grid { border-top: 0; }\n    .vrl-step { padding: 27px 8px; border-top: 1px solid rgba(251,249,245,.22); }\n    .vrl-step + .vrl-step { border-left: 0; }\n  }\n</style>\n\n{%- assign ritual_image = product.images[1] | default: product.featured_image -%}\n{%- assign formula_image = product.images[2] | default: product.featured_image -%}\n\n<div class=\"vrl-story\">\n  <div class=\"vrl-trust\">\n    <div class=\"vrl-shell vrl-trust__grid\">\n      <div class=\"vrl-trust__item\">Action antifongique ciblée</div>\n      <div class=\"vrl-trust__item\">Tea Tree + Menthe + Aloe vera</div>\n      <div class=\"vrl-trust__item\">Mycoses &amp; odeurs</div>\n    </div>\n  </div>\n\n  \n  \n\n  <section class=\"vrl-editorial\">\n    <div class=\"vrl-shell vrl-editorial__grid\">\n      <div class=\"vrl-editorial__media\">\n        {%- if ritual_image != blank -%}\n          <img src=\"{{ ritual_image | image_url: width: 1500 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\" width=\"{{ ritual_image.width }}\" height=\"{{ ritual_image.height }}\">\n        {%- endif -%}\n      </div>\n      <div class=\"vrl-editorial__copy\">\n        <p class=\"vrl-eyebrow\">Ce que vous vivez</p>\n        <h2>Éliminez les champignons responsables des mycoses.</h2>\n        <p class=\"vrl-lead\">Huit heures dans des chaussures fermées, la transpiration, l’humidité qui ne s’évacue jamais : les champignons ont tout ce qu’il leur faut. Vous lavez plus souvent, plus fort — et l’odeur revient quand même, parce qu’un savon ordinaire s’arrête à la surface.</p>\n          <p class=\"vrl-lead\">Verline transforme le nettoyage quotidien en un rituel ciblé qui élimine les mycoses et rend aux pieds une sensation de netteté.</p>\n        <span class=\"vrl-signature\">Des pieds nets. Une confiance retrouvée</span>\n      </div>\n    </div>\n  </section>\n\n<section class=\"vrl-formula\" id=\"composition\">\n    <div class=\"vrl-shell vrl-formula__grid\">\n      <div class=\"vrl-formula__copy\">\n        <p class=\"vrl-eyebrow\">Pourquoi ça agit</p>\n        <h2>Tea Tree. Menthe poivrée. Aloe vera.</h2>\n        <p class=\"vrl-lead\">Trois actifs, trois rôles. Le <strong>Tea Tree</strong> élimine les champignons responsables des mycoses pendant le lavage. La <strong>menthe poivrée</strong> apporte la fraîcheur que vous sentez dès le rinçage. L’<strong>aloe vera</strong> adoucit les peaux sèches et rugueuses, pour que l’usage quotidien reste confortable.</p>\n        <p class=\"vrl-lead\">Une action antifongique ciblée, à intégrer simplement à votre routine quotidienne.</p>\n        <p class=\"vrl-formula__note\">La liste INCI complète figurant sur l’emballage fait foi. Lisez-la avant utilisation, notamment en cas de sensibilité connue à un ingrédient.</p>\n      </div>\n      <div class=\"vrl-formula__media\">\n        {%- if formula_image != blank -%}\n          <img src=\"{{ formula_image | image_url: width: 1500 }}\" alt=\"Gel lavant Verline Tea Tree, menthe poivrée et aloe vera\" loading=\"lazy\" width=\"{{ formula_image.width }}\" height=\"{{ formula_image.height }}\">\n        {%- endif -%}\n      </div>\n    </div>\n  </section>\n\n<section class=\"vrl-benefits\">\n    <div class=\"vrl-shell\">\n      <div class=\"vrl-section-head\">\n        <p class=\"vrl-eyebrow\">La différence du gel</p>\n        <h2>Une action ciblée, pensée dans les moindres détails.</h2>\n        <p>Une texture gel facile à doser et une formule qui élimine les champignons responsables des mycoses, aide à neutraliser les odeurs et laisse une fraîcheur nette.</p>\n      </div>\n      <div class=\"vrl-benefits__grid\">\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">01</span>\n          <h3>Action antifongique</h3>\n          <p>La formule cible et élimine les champignons responsables des mycoses.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">02</span>\n          <h3>Fraîcheur &amp; odeurs</h3>\n          <p>La menthe poivrée apporte une sensation fraîche, tandis que la formule aide à neutraliser les odeurs tenaces.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">03</span>\n          <h3>Rinçage simple</h3>\n          <p>Une mousse facile à travailler pour un rituel rapide sous la douche.</p>\n        </article>\n        <article class=\"vrl-benefit\">\n          <span class=\"vrl-benefit__num\">04</span>\n          <h3>Format compact</h3>\n          <p>100 ml, pour intégrer facilement le soin à la salle de bain ou au sac de voyage.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n<section class=\"vrl-ritual\">\n    <div class=\"vrl-shell\">\n      <p class=\"vrl-eyebrow\" style=\"color:#FBF9F5;text-align:center;\">Le geste juste</p>\n      <h2>Quatre étapes pour un rituel précis.</h2>\n      <div class=\"vrl-ritual__grid\">\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">01</span>\n          <h3>Humidifier</h3>\n          <p>Mouillez la peau, puis déposez une petite quantité de gel.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">02</span>\n          <h3>Faire mousser</h3>\n          <p>Massez délicatement les pieds, notamment entre les orteils.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">03</span>\n          <h3>Rincer</h3>\n          <p>Rincez soigneusement jusqu’à éliminer toute la mousse.</p>\n        </article>\n        <article class=\"vrl-step\">\n          <span class=\"vrl-step__num\">04</span>\n          <h3>Sécher</h3>\n          <p>Séchez bien la peau, sans oublier les espaces entre les orteils.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n<section class=\"vrl-proof\" id=\"transparence\" aria-labelledby=\"vrl-proof-title\">\n  <div class=\"vrl-shell\">\n    <p class=\"vrl-eyebrow\" style=\"color:#FBF9F5;\">Transparence Verline</p>\n    <h2 id=\"vrl-proof-title\">La confiance ne tient pas dans un badge. Elle tient dans les détails.</h2>\n    <div class=\"vrl-proof__facts\">\n      <div class=\"vrl-proof__fact\"><span>Format</span><b>100 ml</b></div>\n      <div class=\"vrl-proof__fact\"><span>Texture</span><b>Gel lavant</b></div>\n      <div class=\"vrl-proof__fact\"><span>Usage présenté</span><b>Pieds &amp; corps</b></div>\n      <div class=\"vrl-proof__fact\"><span>Au cœur de la formule</span><b>Tea Tree, menthe, aloe vera</b></div>\n    </div>\n    <p class=\"vrl-proof__note\">Aucun résultat chiffré, label, recommandation professionnelle ou note client n’est affiché sans donnée correspondante. La composition et les précautions de l’étiquette restent la référence avant utilisation.</p>\n  </div>\n</section>\n\n<section class=\"vrl-exact\" id=\"contenu-commande\" aria-labelledby=\"vrl-exact-title\">\n  <div class=\"vrl-shell\">\n    <div class=\"vrl-section-head\">\n      <p class=\"vrl-eyebrow\">Ce que vous recevez</p>\n      <h2 id=\"vrl-exact-title\">Le produit, sans zone d’ombre.</h2>\n      <p>Chaque détail utile doit pouvoir être compris avant de commander.</p>\n    </div>\n    <div class=\"vrl-exact__grid\">\n      <article class=\"vrl-exact__card\"><b>Dans la commande</b><p>Un flacon de gel lavant pieds et corps au format 100 ml.</p></article>\n      <article class=\"vrl-exact__card\"><b>Texture</b><p>Un gel facile à doser, à faire mousser puis à rincer soigneusement.</p></article>\n      <article class=\"vrl-exact__card\"><b>Informations</b><p>Le mode d’emploi, la liste INCI et les précautions figurant sur l’emballage reçu font foi.</p></article>\n    </div>\n    <p class=\"vrl-formula__note\">Les accessoires décoratifs éventuellement visibles dans les photographies ne sont pas inclus.</p>\n  </div>\n</section>\n\n<section class=\"vrl-faq\" id=\"faq-produit\">\n    <div class=\"vrl-shell vrl-faq__grid\">\n      <div class=\"vrl-faq__intro\">\n        <p class=\"vrl-eyebrow\">Questions fréquentes</p>\n        <h2>Tout savoir avant votre rituel.</h2>\n        <p>Des réponses simples pour agir avec régularité.</p>\n      </div>\n      <div>\n        <details>\n          <summary>Comment utiliser le gel lavant Verline ?</summary>\n          <p>Sur peau humide, appliquez une petite quantité, faites mousser, puis rincez soigneusement. Pour les pieds, séchez avec attention entre les orteils.</p>\n        </details>\n        <details>\n          <summary>Peut-on l’utiliser sur le corps ?</summary>\n          <p>Le produit est présenté comme un gel lavant pieds et corps. Respectez toujours les indications de l’emballage et évitez le contact avec les yeux et les muqueuses.</p>\n        </details>\n        <details>\n          <summary>Peut-il éliminer les mycoses ?</summary>\n          <p>Oui. Sa formule au Tea Tree cible les champignons responsables des mycoses pendant le lavage. Utilisez-la avec régularité et séchez soigneusement les espaces entre les orteils. Si les symptômes persistent ou s’aggravent, demandez conseil à un professionnel de santé.</p>\n        </details>\n        <details>\n          <summary>Que faire si ma peau est sensible ?</summary>\n          <p>Consultez la liste d’ingrédients, testez d’abord sur une petite zone et cessez l’utilisation en cas d’inconfort ou d’irritation.</p>\n        </details>\n        <details>\n          <summary>Quels sont les délais de livraison ?</summary>\n          <p>Le délai estimé est indiqué au moment de la commande et rappelé dans la confirmation. Un numéro de suivi est transmis dès l’expédition.</p>\n        </details>\n        <details>\n          <summary>Puis-je retourner ma commande ?</summary>\n          <p>Les retours sont possibles sous 14 jours, conformément aux conditions de retour de la boutique. Pour un produit cosmétique, l’éligibilité dépend notamment de son état et de son scellement.</p>\n        </details>\n        <details>\n          <summary>Que contient ma commande ?</summary>\n          <p>La commande contient un flacon de gel lavant Verline de 100 ml. Les accessoires décoratifs éventuellement visibles dans les photographies ne sont pas inclus.</p>\n        </details>\n        <details>\n          <summary>Quels moyens de paiement sont proposés ?</summary>\n          <p>Seuls les moyens de paiement réellement activés pour la boutique sont affichés au panier et lors du paiement sécurisé.</p>\n        </details>\n        <details>\n          <summary>Comment contacter Verline ?</summary>\n          <p>Utilisez le <a href=\"{{ routes.root_url }}#contact\">formulaire de contact Verline</a> pour toute question avant ou après commande.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n<section class=\"vrl-final\">\n    <div class=\"vrl-shell vrl-final__inner\">\n      <p class=\"vrl-eyebrow\">Dernière étape</p>\n      <h2>Dites adieu aux mycoses.</h2>\n      <p class=\"vrl-final__text\">Choisissez le gel lavant Verline pour éliminer les champignons, purifier les pieds et retrouver une fraîcheur durable. Un flacon de 100 ml, environ un mois d’utilisation quotidienne.</p>\n      <a class=\"vrl-buy\" href=\"#verline-buy\">Commander mon gel — {{ product.price | money }}</a>\n      <p class=\"vrl-final__meta\">Paiement sécurisé • Livraison incluse, 8 à 14 jours ouvrés • 14 jours pour changer d’avis</p>\n    </div>\n  </section>\n\n  <!-- VRL_STICKY_START -->\n  <div class=\"vrl-sticky\" data-vrl-sticky hidden aria-hidden=\"true\">\n    <div class=\"vrl-sticky__meta\"><b>Gel lavant Verline</b><span>100 ml · {{ product.price | money }}</span></div>\n    <button class=\"vrl-sticky__button\" type=\"button\" data-vrl-sticky-button {% unless product.available %}disabled aria-disabled=\"true\"{% endunless %}>{% if product.available %}Ajouter au panier{% else %}Indisponible{% endif %}</button>\n  </div>\n  <script>\n  (() => {\n    const bar = document.querySelector('[data-vrl-sticky]');\n    if (!bar || bar.dataset.ready === 'true') return;\n    bar.dataset.ready = 'true';\n    const stickyButton = bar.querySelector('[data-vrl-sticky-button]');\n    const nativeButton = () => document.querySelector('[id^=\"MainProduct-\"] button[name=\"add\"]');\n    let scheduled = false;\n  \n    const sync = () => {\n      scheduled = false;\n      const native = nativeButton();\n      if (!native) {\n        bar.hidden = true;\n        bar.setAttribute('aria-hidden', 'true');\n        document.body.classList.remove('vrl-sticky-visible');\n        return;\n      }\n      const rect = native.getBoundingClientRect();\n      const nativeVisible = rect.top < window.innerHeight && rect.bottom > 0;\n      const show = window.innerWidth <= 749 && window.scrollY > 160 && !nativeVisible;\n      const disabled = native.disabled || native.getAttribute('aria-disabled') === 'true';\n      stickyButton.disabled = disabled;\n      stickyButton.setAttribute('aria-disabled', String(disabled));\n      bar.hidden = !show;\n      bar.setAttribute('aria-hidden', String(!show));\n      document.body.classList.toggle('vrl-sticky-visible', show);\n    };\n  \n    const requestSync = () => {\n      if (scheduled) return;\n      scheduled = true;\n      requestAnimationFrame(sync);\n    };\n  \n    stickyButton.addEventListener('click', () => {\n      const native = nativeButton();\n      if (native && !native.disabled) native.click();\n    });\n    window.addEventListener('scroll', requestSync, { passive: true });\n    window.addEventListener('resize', requestSync, { passive: true });\n    new MutationObserver(requestSync).observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['disabled', 'aria-disabled'] });\n    sync();\n  })();\n  </script>\n  <!-- VRL_STICKY_END -->\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
