        "reassurance": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<button type=\"button\" class=\"vrl-buy-now\" data-vrl-buy-now>Acheter maintenant</button>\n<p class=\"vrl-buy-now-status\" data-vrl-buy-now-status role=\"status\" aria-live=\"polite\"></p>\n\n<div class=\"vrl-payment-panel\">\n  {%- if shop.enabled_payment_types != empty -%}\n    <span class=\"vrl-payment-panel__label\">Plusieurs moyens de paiement sécurisés</span>\n    <ul class=\"vrl-main-payments\" aria-label=\"Moyens de paiement activés\">\n      {%- for type in shop.enabled_payment_types -%}\n        <li>{{ type | payment_type_svg_tag }}</li>\n      {%- endfor -%}\n    </ul>\n  {%- else -%}\n    <p class=\"vrl-payment-fallback\">Paiement sécurisé · Les moyens disponibles s’afficheront à l’étape de paiement.</p>\n  {%- endif -%}\n</div>\n\n<div class=\"vrl-main-trust\">\n  <a href=\"{% if shop.shipping_policy != blank %}{{ shop.shipping_policy.url }}{% else %}{{ routes.root_url }}#faq{% endif %}\">Livraison détaillée avant paiement</a>\n  <a href=\"{% if shop.refund_policy != blank %}{{ shop.refund_policy.url }}{% else %}{{ routes.root_url }}#faq{% endif %}\">Retours selon les conditions</a>\n  <span>Commande protégée</span>\n</div>\n\n<script>\n(() => {\n  const button = document.querySelector('#MainProduct-{{ section.id }} [data-vrl-buy-now]');\n  if (!button || button.dataset.ready === 'true') return;\n  button.dataset.ready = 'true';\n\n  const status = document.querySelector('#MainProduct-{{ section.id }} [data-vrl-buy-now-status]');\n  const form = document.getElementById('product-form-{{ section.id }}') ||\n    document.querySelector('#MainProduct-{{ section.id }} form[action*=\"/cart/add\"]');\n  const addButton = form ? form.querySelector('[name=\"add\"]') : null;\n\n  const syncAvailability = () => {\n    const unavailable = !form || !addButton || addButton.disabled;\n    button.disabled = unavailable;\n    button.setAttribute('aria-disabled', unavailable ? 'true' : 'false');\n  };\n\n  syncAvailability();\n  if (addButton) {\n    new MutationObserver(syncAvailability).observe(addButton, {\n      attributes: true,\n      attributeFilter: ['disabled', 'class']\n    });\n  }\n\n  button.addEventListener('click', async () => {\n    if (!form || button.disabled) return;\n    if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;\n\n    button.disabled = true;\n    button.setAttribute('aria-busy', 'true');\n    if (status) status.textContent = 'Préparation de votre commande…';\n\n    try {\n      const response = await fetch('{{ routes.cart_add_url }}.js', {\n        method: 'POST',\n        headers: { 'Accept': 'application/json' },\n        body: new FormData(form)\n      });\n      if (!response.ok) {\n        const payload = await response.json().catch(() => ({}));\n        throw new Error(payload.description || payload.message || 'Ajout impossible');\n      }\n      window.location.assign('{{ routes.root_url }}checkout');\n    } catch (error) {\n      if (status) status.textContent = error.message || 'Une erreur est survenue. Réessayez.';\n      button.removeAttribute('aria-busy');\n      syncAvailability();\n    }\n  });\n})();\n</script>"
          }
