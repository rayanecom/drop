{%- liquid
  assign keep = section.settings.photo_keep
  if keep < 20
    assign keep = 64
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --vap-green:  #173F32;
    --vap-cream:  #F7F4EC;
    --vap-card:   #FFFEFA;
    --vap-text:   #29342E;
    --vap-muted:  #7A837E;
    --vap-gold:   #B5914B;
    --vap-empty:  #D9DEDA;
    --vap-border: #DDE4DF;
    --vap-gap:    14px;
    --vap-per:    1;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} { --vap-per: {{ section.settings.cards_desktop }}; --vap-gap: 20px; }
  }

  .vap-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .vap-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="vap vap-{{ section.id }}">
  <div class="vap__shell">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vap__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="vap__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vap__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="vap__stage">
      <button class="vap__nav vap__nav--prev" type="button" aria-label="Avis précédent" data-vap-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.2 4.4 7.6 12l7.6 7.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <ul class="vap__track" data-vap-track role="list">
        {%- for block in section.blocks -%}
          {%- assign img = block.settings.image -%}
          <li class="vap__card" {{ block.shopify_attributes }}>

            {%- if img != blank -%}
              {%- assign crop_h = img.height | times: keep | divided_by: 100 -%}
              {%- assign out_w = 1000 -%}
              {%- assign out_h = out_w | times: crop_h | divided_by: img.width -%}
              <div class="vap__photo" style="--vap-ratio: {{ out_w }} / {{ out_h }};">
                {{
                  img
                  | image_url: width: out_w, height: out_h, crop: 'top'
                  | image_tag:
                      loading: 'lazy',
                      decoding: 'async',
                      class: 'vap__img',
                      alt: block.settings.name
                }}
              </div>
            {%- else -%}
              <div class="vap__photo" style="--vap-ratio: 5 / 4;">
                {{ 'image' | placeholder_svg_tag: 'vap__img placeholder' }}
              </div>
            {%- endif -%}

            <div class="vap__body">
              <div class="vap__ident">
                <p class="vap__who">
                  <span class="vap__name">{{ block.settings.name }}</span>
                  {%- if block.settings.meta != blank -%}
                    <span class="vap__meta">{{ block.settings.meta }}</span>
                  {%- endif -%}
                </p>
                {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
                  <span class="vap__badge">
                    <span class="vap__check" aria-hidden="true">&#10003;</span>{{ section.settings.badge_text }}
                  </span>
                {%- endif -%}
              </div>

              {%- assign r = block.settings.rating -%}
              <p class="vap__stars" role="img" aria-label="{{ r }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  <span class="vap__star{% if i > r %} vap__star--off{% endif %}" aria-hidden="true">&#9733;</span>
                {%- endfor -%}
              </p>

              {%- if block.settings.quote != blank -%}
                <p class="vap__quote">{{ block.settings.quote }}</p>
              {%- endif -%}
            </div>

          </li>
        {%- endfor -%}
      </ul>

      <button class="vap__nav vap__nav--next" type="button" aria-label="Avis suivant" data-vap-next>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.8 4.4 16.4 12l-7.6 7.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

  </div>
</div>

<style>
  .vap { background: var(--vap-cream); }
  .vap *, .vap *::before, .vap *::after { box-sizing: border-box; }

  .vap__shell { width: min(1200px, calc(100% - 28px)); margin: 0 auto; }

  .vap__head { margin-bottom: 18px; text-align: center; }
  .vap__title {
    margin: 0;
    color: var(--vap-green);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(26px, 5vw, 40px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -.02em;
  }
  .vap__sub {
    margin: 8px 0 0;
    color: var(--vap-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .vap__stage { position: relative; }

  .vap__track {
    display: flex;
    gap: var(--vap-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }
  .vap__track::-webkit-scrollbar { display: none; }

  .vap__card {
    flex: 0 0 calc((100% - (var(--vap-per) - 1) * var(--vap-gap)) / var(--vap-per));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--vap-card);
    border: 1px solid var(--vap-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(23,63,50,.03), 0 10px 26px rgba(23,63,50,.05);
  }

  .vap__photo {
    aspect-ratio: var(--vap-ratio, 5 / 4);
    background: var(--vap-empty);
  }
  .vap__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vap__body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 16px 17px 18px;
    font-family: var(--font-body-family, -apple-system, "Segoe UI", Arial, sans-serif);
  }

  .vap__ident { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .vap__who { display: flex; align-items: baseline; gap: 8px; margin: 0; flex-wrap: wrap; min-width: 0; }
  .vap__name { color: var(--vap-green); font-size: 16px; font-weight: 700; line-height: 1.15; }
  .vap__meta { color: var(--vap-muted); font-size: 12px; line-height: 1.2; }

  .vap__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    padding: 5px 9px;
    color: var(--vap-green);
    background: #EDF3EF;
    border: 1px solid #D9E4DC;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }
  .vap__check {
    display: inline-flex;
    width: 15px;
    height: 15px;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    background: var(--vap-green);
    border-radius: 50%;
    font-size: 9px;
  }

  .vap__stars { margin: 0; color: var(--vap-gold); font-size: 15px; letter-spacing: 2px; line-height: 1; }
  .vap__star--off { color: var(--vap-empty); }

  .vap__quote { margin: 2px 0 0; color: var(--vap-text); font-size: 16px; line-height: 1.6; }

  .vap__nav {
    position: absolute;
    top: 32%;
    z-index: 2;
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    transform: translateY(-50%);
    align-items: center;
    justify-content: center;
    color: var(--vap-green);
    background: rgba(255,254,250,.94);
    border: 1px solid var(--vap-border);
    border-radius: 50%;
    box-shadow: 0 3px 12px rgba(23,63,50,.14);
    cursor: pointer;
  }
  .vap__nav svg { width: 19px; height: 19px; }
  .vap__nav--prev { left: -6px; }
  .vap__nav--next { right: -6px; }
  .vap__nav[hidden] { display: none !important; }
  .vap__stage:not([data-vap-single]) .vap__nav { display: flex; }

  @media screen and (min-width: 750px) {
    .vap__shell { width: min(1200px, calc(100% - 64px)); }
    .vap__nav { width: 46px; height: 46px; }
    .vap__nav--prev { left: -22px; }
    .vap__nav--next { right: -22px; }
    .vap__body { padding: 18px 20px 20px; }
    .vap__name { font-size: 17px; }
    .vap__quote { font-size: 15px; line-height: 1.62; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vap__track { scroll-behavior: auto; }
  }
</style>

<script>
(function () {
  document.querySelectorAll('[data-vap-track]').forEach(function (track) {
    if (track.dataset.vapReady === '1') return;
    track.dataset.vapReady = '1';

    var stage = track.closest('.vap__stage');
    var prev  = stage.querySelector('[data-vap-prev]');
    var next  = stage.querySelector('[data-vap-next]');

    function step() {
      var card = track.querySelector('.vap__card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function sync() {
      var max = track.scrollWidth - track.clientWidth - 2;
      var noScroll = max <= 0;
      stage.toggleAttribute('data-vap-single', noScroll);
      prev.hidden = noScroll || track.scrollLeft <= 2;
      next.hidden = noScroll || track.scrollLeft >= max;
    }

    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left:  step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
})();
</script>

{% schema %}
{
  "name": "Avis clients en photo",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils l'utilisent au quotidien"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "range",
      "id": "photo_keep",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Hauteur de photo conservée",
      "info": "Recadre la photo par le haut. Baisse la valeur tant qu'un cartouche de texte reste visible en bas de l'image. 100 % = photo entière.",
      "default": 64
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Avis visibles sur ordinateur",
      "info": "Sur mobile, toujours un seul avis par écran.",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Afficher la pastille de vérification",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte de la pastille",
      "default": "Avis vérifié"
    },
    {
      "type": "header",
      "content": "Marges de section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge haute",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge basse",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "avis",
      "name": "Avis",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Prénom", "default": "Prénom" },
        { "type": "text", "id": "meta", "label": "Âge ou ville" },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Étoiles",
          "default": 5
        },
        { "type": "textarea", "id": "quote", "label": "Avis" }
      ]
    }
  ],
  "presets": [
    { "name": "Avis clients en photo" }
  ]
}
{% endschema %}
