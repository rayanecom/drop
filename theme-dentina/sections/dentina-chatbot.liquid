  /* Reponses dependantes des donnees de la boutique. */
  (function fillDynamic() {
    for (var i = 0; i < KB.length; i++) {
      if (KB[i].id === 'prix') {
        KB[i].a = D.prix
          ? '<p>DentinaClean est à <strong>' + D.prix + '</strong>, livraison offerte en France métropolitaine.</p>' +
            '<p>Le prix affiché sur la fiche produit fait foi.</p>'
          : '<p>Le prix est affiché sur la fiche produit, livraison offerte en France métropolitaine.</p>';
      }
      if (KB[i].id === 'paiement') {
        KB[i].a = '<p>Le paiement est <strong>sécurisé</strong> : vos données bancaires sont chiffrées et ne transitent jamais par notre site.</p>' +
          (D.paiements ? '<p>Moyens acceptés : ' + D.paiements + '.</p>' : '');
      }
    }
  })();

  /* =====================================================================
     4. Notation
     Une intention est candidate si chacun de ses groupes « all » trouve au
     moins un concept dans la question. Le score departage ensuite : plus
     l'intention est specifique, plus elle pese.
     ===================================================================== */
  function score(found, item) {
    var i, g, ok, hitAll = 0;
    for (i = 0; i < item.all.length; i++) {
      g = item.all[i]; ok = 0;
      for (var j = 0; j < g.length; j++) if (found[g[j]]) { ok = 1; break; }
      if (!ok) return -1;
      hitAll++;
    }
    var bonus = 0;
    for (i = 0; i < item.any.length; i++) if (found[item.any[i]]) bonus++;
    /* Un « all » a deux groupes prime sur un « all » a un seul groupe. */
    return hitAll * 10 + item.all.length * 4 + bonus;
  }

  function answer(q) {
    var found = conceptsOf(q);
    var best = null, bestScore = 0;
    for (var i = 0; i < KB.length; i++) {
      var sc = score(found, KB[i]);
      if (sc > bestScore) { bestScore = sc; best = KB[i]; }
    }
    if (!best) return null;
    return { item: best, score: bestScore };
  }

  /* =====================================================================
     5. Interface
     ===================================================================== */
  var SUGGEST = [
    ['Livraison', 'Quels sont les délais de livraison ?'],
    ['Retours', 'Puis-je être remboursé ?'],
    ['Utilisation', 'Comment ça marche ?'],
    ['Compatibilité', 'Est-ce compatible avec ma gouttière ?'],
    ['Garantie', 'Quelle est la garantie ?'],
    ['Prix', 'Combien ça coûte ?']
  ];

  function el(tag, cls, html) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (html != null) n.innerHTML = html;
    return n;
  }

  function scrollDown() { log.scrollTop = log.scrollHeight; }

  function say(html, who) {
    var m = el('div', 'dtc__msg dtc__msg--' + who, html);
    log.appendChild(m);
    scrollDown();
    return m;
  }

  function linksHtml(links) {
    if (!links || !links.length) return '';
    var out = '<p>';
    for (var i = 0; i < links.length; i++) {
      var href = D[links[i][1]];
      if (!href) continue;
      out += (i ? ' · ' : '') + '<a href="' + href + '">' + links[i][0] + '</a>';
    }
    return out + '</p>';
  }

  function renderChips(list) {
    chips.textContent = '';
    for (var i = 0; i < list.length; i++) {
      var b = el('button', 'dtc__chip', list[i][0]);
      b.type = 'button';
      b.dataset.q = list[i][1];
      chips.appendChild(b);
    }
  }

  var FALLBACK =
    '<p>Je n’ai pas de réponse sûre à cette question, et je préfère ne pas inventer.</p>' +
    '<p>Notre service client vous répondra précisément — ou reformulez, je réessaie volontiers.</p>';

  function reply(q) {
    var typing = say('<span class="dtc__typing"><i></i><i></i><i></i></span>', 'bot');
    var res = answer(q);
    /* Latence courte : le temps de lire que la reponse arrive, sans attente. */
    setTimeout(function () {
      var html, links;
      if (res && res.score >= 14) {
        html = res.item.a;
        links = res.item.links;
      } else {
        html = FALLBACK;
        links = [['Nous contacter', 'urlContact']];
      }
      typing.innerHTML = html + linksHtml(links);
      scrollDown();
      renderChips(SUGGEST);
    }, 260);
  }

  function send(q) {
    q = String(q || '').trim();
    if (!q) return;
    say(q.replace(/[<>&]/g, function (c) {
      return { '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c];
    }), 'user');
    input.value = '';
    chips.textContent = '';
    reply(q);
  }

  var started = false;
  function open() {
    root.classList.add('is-open', 'is-seen');
    panel.hidden = false;
    openBtn.setAttribute('aria-expanded', 'true');
    openBtn.setAttribute('aria-label', 'Fermer l’assistant Dentina');
    if (!started) {
      started = true;
      say('<p>' + (D.accueil || 'Bonjour !') + '</p>', 'bot');
      renderChips(SUGGEST);
    }
    /* La mise au point automatique ferait remonter le clavier sur mobile et
       masquerait la conversation : on ne la force que sur grand ecran. */
    if (window.matchMedia('(min-width: 561px)').matches) {
      setTimeout(function () { input.focus(); }, 120);
    }
  }

  function close() {
    root.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
    openBtn.setAttribute('aria-label', 'Ouvrir l’assistant Dentina');
    setTimeout(function () { if (!root.classList.contains('is-open')) panel.hidden = true; }, 220);
    openBtn.focus();
  }

  openBtn.addEventListener('click', function () {
    root.classList.contains('is-open') ? close() : open();
  });

  root.querySelector('[data-dtc-close]').addEventListener('click', close);

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    send(input.value);
  });

  chips.addEventListener('click', function (e) {
    var b = e.target.closest('.dtc__chip');
    if (b) send(b.dataset.q);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && root.classList.contains('is-open')) close();
  });

  root.hidden = false;
})();
